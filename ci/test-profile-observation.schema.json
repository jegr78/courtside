{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:ci:test-profile-observation:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "runId", "attempt", "isFirstAttempt", "commit", "startedAt", "policyFingerprint", "plannerOutcome", "proposedProfiles", "proposedJobs", "actualJobs", "jobsOutsideProposal", "failuresOutsideProposal", "incompleteJobs", "classificationOutcome"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
    "runId": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "isFirstAttempt": { "type": "boolean" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "policyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "activePolicyFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "admissionOutcome": { "enum": ["matched", "missing", "stale", "invalid"] },
    "overrideOutcome": { "enum": ["admitted", "emergency-full", "invalid-full"] },
    "activeProfiles": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["docs", "backend", "frontend", "full"] }, "uniqueItems": true },
    "activeJobs": { "$ref": "#/$defs/jobNames" },
    "plannerOutcome": { "enum": ["passed", "failed"] },
    "proposedProfiles": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["docs", "backend", "frontend", "full"] }, "uniqueItems": true },
    "proposedJobs": { "$ref": "#/$defs/jobNames" },
    "actualJobs": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/job" } },
    "jobsOutsideProposal": { "$ref": "#/$defs/jobNames" },
    "failuresOutsideProposal": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/job" } },
    "incompleteJobs": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/job" } },
    "classificationOutcome": { "enum": ["no-observed-miss", "candidate-miss", "classification-error", "observation-incomplete", "rerun-not-evaluated"] }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] },
      "then": {
        "properties": {
          "activePolicyFingerprint": true,
          "admissionOutcome": true,
          "overrideOutcome": true,
          "activeProfiles": true,
          "activeJobs": true
        },
        "required": ["activePolicyFingerprint", "admissionOutcome", "overrideOutcome", "activeProfiles", "activeJobs"]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["activePolicyFingerprint"] },
            { "required": ["admissionOutcome"] },
            { "required": ["overrideOutcome"] },
            { "required": ["activeProfiles"] },
            { "required": ["activeJobs"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "jobName": { "enum": ["docs", "backend", "frontend", "security"] },
    "jobNames": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/jobName" }, "uniqueItems": true },
    "outcome": { "enum": ["success", "failure", "cancelled", "timed_out", "action_required", "neutral", "skipped", "startup_failure", "stale"] },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome"],
      "properties": {
        "name": { "$ref": "#/$defs/jobName" },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    }
  }
}
