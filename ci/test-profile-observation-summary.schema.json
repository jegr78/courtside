{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:ci:test-profile-observation-summary:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["sampleSize", "repository", "policyFingerprint", "windowStartedAt", "observedFirstAttemptCount", "rerunCount", "windowDays", "fullProposalCount", "naturalReducedProfileCount", "actualReducedProfileCount", "actualFullProfileRate", "proposedProfileCounts", "candidateMissCount", "classificationErrorCount", "incompleteObservationCount", "incompatibleBaseCount", "assessedAt", "limitations", "status"],
  "properties": {
    "sampleSize": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
    "policyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "windowStartedAt": { "type": "string", "format": "date-time" },
    "observedFirstAttemptCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "rerunCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "windowDays": { "type": "integer", "minimum": 0 },
    "fullProposalCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "naturalReducedProfileCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "actualReducedProfileCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "actualFullProfileRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "proposedProfileCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docs", "backend", "frontend", "tooling", "full"],
      "properties": {
        "docs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "backend": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "frontend": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "tooling": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "full": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "candidateMissCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "classificationErrorCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "incompleteObservationCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "incompatibleBaseCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "assessedAt": { "type": "string", "format": "date-time" },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    },
    "status": { "enum": ["collecting", "ready-for-review", "under-classification-observed"] }
  }
}
