{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:ci:timing:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "runId", "attempt", "isFirstAttempt", "event", "commit", "outcome", "startedAt", "completedAt", "durationMilliseconds", "timeToFirstFailureMilliseconds", "url", "jobs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
    "runId": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "isFirstAttempt": { "type": "boolean" },
    "event": { "enum": ["pull_request", "push"] },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMilliseconds": { "type": "integer", "minimum": 0 },
    "timeToFirstFailureMilliseconds": { "type": ["integer", "null"], "minimum": 0 },
    "url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_./-]+$", "maxLength": 500 },
    "jobs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/job" } }
  },
  "$defs": {
    "outcome": { "enum": ["success", "failure", "cancelled", "timed_out", "action_required", "neutral", "skipped", "startup_failure", "stale"] },
    "timed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome", "startedAt", "completedAt", "durationMilliseconds"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "outcome", "startedAt", "completedAt", "durationMilliseconds", "runner", "steps"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "labels"],
          "properties": {
            "kind": { "enum": ["github-hosted", "self-hosted", "not-assigned"] },
            "labels": { "type": "array", "maxItems": 10, "items": { "enum": ["self-hosted", "linux", "windows", "macos", "x64", "arm64", "ubuntu-latest", "ubuntu-24.04", "windows-latest", "macos-latest"] }, "uniqueItems": true }
          }
        },
        "steps": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/timed" } }
      }
    }
  }
}
