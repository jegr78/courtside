{
  "schemaVersion": 1,
  "profileOrder": ["docs", "backend", "frontend", "tooling", "full"],
  "ciJobOrder": [
    "docs", "backend", "frontend", "browser_visual", "browser", "deployment", "tooling", "security", "gates",
    "clock_shift"
  ],
  "profiles": {
    "docs": {
      "ciJobs": ["docs", "tooling"],
      "localTasks": ["frontend-toolchain", "docs-check", "site-install", "site-build", "tooling-test"]
    },
    "backend": {
      "ciJobs": ["backend", "tooling", "security", "gates"],
      "localTasks": ["frontend-toolchain", "backend", "tooling-test"]
    },
    "frontend": {
      "ciJobs": ["frontend", "browser_visual", "browser", "tooling", "security", "gates"],
      "localTasks": [
        "frontend-toolchain",
        "frontend-lint",
        "frontend-test",
        "frontend-build",
        "frontend-package",
        "frontend-e2e",
        "tooling-test"
      ]
    },
    "tooling": {
      "ciJobs": ["tooling", "security", "clock_shift"],
      "localTasks": ["frontend-toolchain", "tooling-test"]
    },
    "full": {
      "ciJobs": [
        "docs", "backend", "frontend", "browser_visual", "browser", "deployment", "tooling", "security", "gates",
        "clock_shift"
      ],
      "localTasks": [
        "workflow-lint",
        "docs-check",
        "full-without-browser",
        "compose-wait-smoke",
        "frontend-e2e",
        "webkit-reliability",
        "gate-uat",
        "gate-mail",
        "gate-restore",
        "gate-upgrade",
        "gate-active-security"
      ]
    }
  },
  "localTaskDefinitions": {
    "workflow-lint": {
      "workingDirectory": "repository",
      "executable": "node",
      "arguments": ["tools/workflow-lint.mjs", "--check"]
    },
    "docs-check": {
      "workingDirectory": "repository",
      "executable": "node",
      "arguments": ["tools/docs-check.mjs", "--check"]
    },
    "backend": {
      "workingDirectory": "repository",
      "executable": "maven",
      "arguments": [
        "clean",
        "verify",
        "-Pjava-only",
        "-Dmaven.test.redirectTestOutputToFile=true"
      ]
    },
    "frontend-toolchain": {
      "workingDirectory": "repository",
      "executable": "maven",
      "arguments": [
        "com.github.eirslett:frontend-maven-plugin:install-node-and-npm",
        "com.github.eirslett:frontend-maven-plugin:npm@npm-ci"
      ]
    },
    "frontend-lint": {
      "workingDirectory": "frontend",
      "executable": "npm",
      "arguments": ["run", "lint"]
    },
    "frontend-test": {
      "workingDirectory": "frontend",
      "executable": "npm",
      "arguments": ["run", "test:frontend"]
    },
    "frontend-build": {
      "workingDirectory": "frontend",
      "executable": "npm",
      "arguments": ["run", "build"]
    },
    "frontend-package": {
      "workingDirectory": "repository",
      "executable": "maven",
      "arguments": ["package", "-DskipTests", "-Pjava-only"]
    },
    "frontend-e2e": {
      "workingDirectory": "frontend",
      "executable": "npm",
      "arguments": ["run", "test:e2e"]
    },
    "site-install": {
      "workingDirectory": "repository",
      "executable": "npm",
      "arguments": ["--prefix", "site", "ci"]
    },
    "site-build": {
      "workingDirectory": "repository",
      "executable": "npm",
      "arguments": ["--prefix", "site", "run", "build"]
    },
    "tooling-test": {
      "workingDirectory": "frontend",
      "executable": "npm",
      "arguments": ["run", "test:tools"]
    },
    "full-without-browser": {
      "workingDirectory": "repository",
      "executable": "maven",
      "arguments": [
        "clean",
        "verify",
        "-Dfrontend.e2e.skip=true",
        "-Dmaven.test.redirectTestOutputToFile=true"
      ]
    },
    "compose-wait-smoke": {
      "workingDirectory": "repository",
      "executable": "node",
      "arguments": ["tools/compose-wait-smoke.mjs"]
    },
    "webkit-reliability": {
      "workingDirectory": "frontend",
      "executable": "npm",
      "arguments": ["run", "reliability:webkit", "--", "--order", "configured"]
    },
    "gate-uat": {
      "workingDirectory": "repository",
      "executable": "node",
      "arguments": ["tools/local-release-gates.mjs", "uat"]
    },
    "gate-mail": {
      "workingDirectory": "repository",
      "executable": "node",
      "arguments": ["tools/local-release-gates.mjs", "mail"]
    },
    "gate-restore": {
      "workingDirectory": "repository",
      "executable": "node",
      "arguments": ["tools/local-release-gates.mjs", "restore"]
    },
    "gate-upgrade": {
      "workingDirectory": "repository",
      "executable": "node",
      "arguments": ["tools/local-release-gates.mjs", "upgrade"]
    },
    "gate-active-security": {
      "workingDirectory": "repository",
      "executable": "node",
      "arguments": ["tools/local-release-gates.mjs", "active-security"]
    }
  },
  "coverageDifferences": [
    {
      "scope": "security",
      "ci": "CodeQL, dependency review, container scanning and security tooling",
      "local": "Security tooling included by Maven verification; hosted CodeQL and dependency review unavailable"
    },
    {
      "scope": "tooling",
      "ci": "Repository tool tests; the security job runs beside them for every profile except documentation",
      "local": "Repository tool tests; hosted CodeQL, dependency review and container scanning unavailable"
    },
    {
      "scope": "site",
      "ci": "The documentation job installs and builds the documentation site whenever it runs",
      "local": "Built by the documentation profile; Maven's full verification does not build the site"
    }
  ]
}
