{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:ci:test-profile-plan:v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "attempt", "baseCommit", "headCommit",
    "activePolicyFingerprint", "proposedPolicyFingerprint", "admissionOutcome",
    "overrideOutcome", "plannerOutcome", "activeProfiles", "proposedProfiles",
    "activeCiJobs", "proposedCiJobs", "activeLocalTasks", "proposedLocalTasks",
    "isFull", "reasons"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "runId": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "headCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "activePolicyFingerprint": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposedPolicyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "admissionOutcome": { "enum": ["matched", "missing", "stale", "invalid"] },
    "overrideOutcome": { "enum": ["admitted", "emergency-full", "invalid-full"] },
    "plannerOutcome": { "enum": ["passed", "failed"] },
    "activeProfiles": { "$ref": "#/$defs/profiles" },
    "proposedProfiles": { "$ref": "#/$defs/profiles" },
    "activeCiJobs": { "$ref": "#/$defs/jobs" },
    "proposedCiJobs": { "$ref": "#/$defs/jobs" },
    "activeLocalTasks": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/task" }
    },
    "proposedLocalTasks": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true
    },
    "isFull": { "type": "boolean" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/reason" }
    }
  },
  "$defs": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "enum": ["docs", "backend", "frontend", "full"] },
      "uniqueItems": true
    },
    "jobs": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "workingDirectory", "executable", "arguments"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "workingDirectory": { "enum": ["repository", "frontend"] },
        "executable": { "enum": ["maven", "npm"] },
        "arguments": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "profile", "status"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 300 },
        "path": { "type": ["string", "null"], "maxLength": 1000 },
        "profile": { "enum": ["docs", "backend", "frontend", "full"] },
        "status": { "type": ["string", "null"], "maxLength": 5 }
      }
    }
  }
}
