{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:ci:test-profile-plan:v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "attempt", "baseCommit", "headCommit", "policyFingerprint", "plannerOutcome", "profiles", "isFull", "reasons"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "runId": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "headCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "policyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plannerOutcome": { "enum": ["passed", "failed"] },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "enum": ["docs", "backend", "frontend", "full"] },
      "uniqueItems": true
    },
    "isFull": { "type": "boolean" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "profile", "status"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 300 },
          "path": { "type": ["string", "null"], "maxLength": 1000 },
          "profile": { "enum": ["docs", "backend", "frontend", "full"] },
          "status": { "type": ["string", "null"], "maxLength": 5 }
        }
      }
    }
  }
}
