{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:ci:test-profile-observation-inventory:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "windowStartedAt", "windowEndedAt", "requiredBaseCommit", "firstAttempts", "incompatibleFirstAttempts"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
    "windowStartedAt": { "type": "string", "format": "date-time" },
    "windowEndedAt": { "type": "string", "format": "date-time" },
    "requiredBaseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "firstAttempts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "commit"],
        "properties": {
          "runId": { "type": "integer", "minimum": 1 },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    },
    "incompatibleFirstAttempts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "commit", "baseCommit"],
        "properties": {
          "runId": { "type": "integer", "minimum": 1 },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    }
  }
}
