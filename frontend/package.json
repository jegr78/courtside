{
  "name": "courtside-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "glob": "13.0.6",
    "js-yaml": "4.3.1"
  },
  "allowScripts": {
    "cpu-features": false,
    "fsevents": true,
    "msw": false,
    "protobufjs": false,
    "ssh2": false
  },
  "scripts": {
    "generate-api": "openapi-typescript ../src/main/resources/api/openapi.yaml -o src/api/schema.d.ts",
    "dev": "npm run generate-api && vite",
    "build": "npm run generate-api && tsc -b && vite build",
    "lint": "npm run generate-api && eslint .",
    "lint:fix": "npm run generate-api && eslint . --fix",
    "test": "npm run test:frontend && npm run test:tools",
    "test:frontend": "npm run generate-api && vitest run --coverage",
    "test:tools": "node ../tools/tool-tests.mjs",
    "test:uat": "node ../tools/courtside.uat-smoke.mjs",
    "test:e2e": "playwright test",
    "audit:security": "node ../tools/npm-audit.mjs",
    "reliability:webkit": "node ../tools/webkit-reliability.mjs run",
    "reliability:webkit-experiment": "node ../tools/webkit-reliability.mjs experiment",
    "reliability:validate": "node ../tools/webkit-reliability.mjs validate",
    "reliability:summarize": "node ../tools/webkit-reliability.mjs summarize",
    "reliability:compare": "node ../tools/webkit-reliability.mjs compare"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "i18next": "26.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
