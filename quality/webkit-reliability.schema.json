{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courtside.example/quality/webkit-reliability.schema.json",
  "title": "Courtside WebKit reliability first-attempt record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attemptId", "sourceCommit", "sourceTreeState", "startedAt", "finishedAt", "durationMs", "executionDeadlineMs", "terminationGraceMs", "toolchain", "matrix", "host", "testPopulation", "browserLifecycle", "outcome"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "attemptId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceTreeState": { "enum": ["clean", "modified"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "executionDeadlineMs": { "const": 1500000 },
    "terminationGraceMs": { "const": 10000 },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playwrightVersion", "browserImage", "browserImageDigest"],
      "properties": {
        "playwrightVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "browserImage": { "type": "string", "pattern": "^mcr\\.microsoft\\.com/playwright:v[0-9]+\\.[0-9]+\\.[0-9]+-[a-z0-9.-]+@sha256:[0-9a-f]{64}$" },
        "browserImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectOrder", "isolationVariant", "resourceProfile", "seedFingerprint"],
      "properties": {
        "projectOrder": { "enum": ["configured", "reversed"] },
        "isolationVariant": { "enum": ["fresh-project-browser", "fresh-test-browser"] },
        "resourceProfile": { "enum": ["local-default", "github-hosted-default"] },
        "seedFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "platform", "architecture", "cpuCount", "totalMemoryBytes"],
      "properties": {
        "provider": { "enum": ["local", "github-hosted"] },
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "architecture": { "enum": ["x64", "arm64"] },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "totalMemoryBytes": { "type": "integer", "minimum": 1 },
        "runnerImage": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 128 }
      }
    },
    "testPopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "fingerprint"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "browserLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "processes"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["processId", "browserName", "startedAt", "samples"],
            "properties": {
              "processId": { "type": "string", "pattern": "^[a-f0-9]{12,64}$|^browser-[0-9]+$" },
              "browserName": { "enum": ["webkit"] },
              "projectName": { "enum": ["webkit-core", "webkit-pwa", "webkit-accessibility"] },
              "startedAt": { "type": "string", "format": "date-time" },
              "finishedAt": { "type": "string", "format": "date-time" },
              "durationMs": { "type": "integer", "minimum": 0 },
              "samples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["recordedAt", "testPosition", "phase", "memoryUsageBytes", "cpuPercent"],
                  "properties": {
                    "recordedAt": { "type": "string", "format": "date-time" },
                    "testPosition": { "type": "integer", "minimum": 1 },
                    "phase": { "enum": ["start", "end"] },
                    "memoryUsageBytes": { "type": "integer", "minimum": 0 },
                    "cpuPercent": { "type": "number", "minimum": 0 }
                  }
                }
              },
              "exitState": {
                "type": "object",
                "additionalProperties": false,
                "required": ["exitCode", "oomKilled", "hasError"],
                "properties": {
                  "exitCode": { "type": "integer", "minimum": 0 },
                  "oomKilled": { "type": "boolean" },
                  "hasError": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classifications", "exitCode"],
      "properties": {
        "status": { "enum": ["passed", "failed", "incomplete"] },
        "classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["none", "product", "harness", "environment"] }
        },
        "exitCode": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
