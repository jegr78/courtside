{
	auto_https disable_redirects
}

# The name the application is served under, here only so that its private key exists: what the mail
# server must not be able to read has to be in the store before anything can prove it cannot.
{$COURTSIDE_DOMAIN} {
	tls internal
	respond 404
}

{$COURTSIDE_MAIL_HOSTNAME} {
	tls internal
	header {
		Content-Security-Policy "base-uri 'none'; frame-ancestors 'none'"
		-Server
		-Via
	}
	respond 404
}
