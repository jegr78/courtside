{
	auto_https disable_redirects
}

http://:80 {
	@browserNavigation {
		host localhost
		method GET HEAD
		path / /courts /login /initial-password /my-bookings /my-messages /account/security /admin /admin/* /index.html /assets/* /icon.svg /manifest.webmanifest /sw.js /workbox-*.js
	}
	handle @browserNavigation {
		header {
			Cache-Control "no-store"
			Content-Security-Policy "base-uri 'none'; frame-ancestors 'none'"
			-Server
			-Via
		}
		redir https://localhost:9443{uri} permanent
	}
	handle {
		header {
			Cache-Control "no-store"
			Content-Security-Policy "base-uri 'none'; frame-ancestors 'none'"
			-Location
			-Server
			-Set-Cookie
			-Via
		}
		respond "Plain HTTP is not accepted." 400
	}
}

https://localhost:443, https://proxy:443 {
	tls internal
	encode zstd gzip

	header {
		+Content-Security-Policy "base-uri 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
		-Via
	}
	@unknownMethod {
		method QUERY
		path /api/*
	}
	method @unknownMethod PATCH

	handle {
		reverse_proxy app:8080 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Prefix
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Ssl
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
