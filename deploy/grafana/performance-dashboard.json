{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Application request rate",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "requests/s" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "title": "Application p95 latency",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "title": "k6 p95 latency",
      "type": "timeseries",
      "targets": [{ "expr": "k6_http_req_duration_p95{testid=~\"$testid\"}", "legendFormat": "{{scenario}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    },
    {
      "title": "JVM heap",
      "type": "timeseries",
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
    },
    {
      "title": "GC pause rate",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(jvm_gc_pause_seconds_sum[1m]))", "legendFormat": "pause/s" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }
    },
    {
      "title": "Live threads",
      "type": "timeseries",
      "targets": [{ "expr": "jvm_threads_live_threads", "legendFormat": "threads" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }
    },
    {
      "title": "Hikari connections",
      "type": "timeseries",
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_idle", "legendFormat": "idle" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }
    },
    {
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "targets": [{ "expr": "pg_stat_database_numbackends{datname=\"courtside_perf\"}", "legendFormat": "connections" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 }
    },
    {
      "title": "PostgreSQL locks",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (mode, granted) (pg_locks_count{datname=\"courtside_perf\"})", "legendFormat": "{{mode}} granted={{granted}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["courtside", "performance"],
  "templating": {
    "list": [
      {
        "name": "testid",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "courtside-prometheus" },
        "query": "label_values(k6_http_reqs_total, testid)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Courtside performance",
  "uid": "courtside-performance",
  "version": 1
}
