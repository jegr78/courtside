#!/usr/bin/env bash
set -euo pipefail

readonly configuration_schema=1
readonly usage="usage: courtside [--directory <path>] <init|reconfigure|backup|restore-check|update|update-check|adopt|rotate-secret|mail-check|doctor|up|status|finalize-bootstrap|diagnose|uninstall> [options]"
script_path=${BASH_SOURCE[0]}
case "$script_path" in
  */*) script_parent=${script_path%/*} ;;
  *)
    script_path=$(command -v "$script_path")
    case "$script_path" in
      */*) script_parent=${script_path%/*} ;;
      *) script_parent=$PWD ;;
    esac
    ;;
esac
script_directory="$(cd "$script_parent" && pwd -P)"
installation_directory=""
lock_directory=""
owns_lock=false
temporary_path=""
docker_path=""
openssl_path=""
sha256sum_path=""
shasum_path=""
env_path=""
curl_path=""
restore_cleanup_active=false
declare -a restore_compose=()
mail_restart_required=false
declare -a mail_restart_compose=()

refuse() {
  printf 'courtside: %s\n' "$1" >&2
  exit 2
}

prepare_executables() {
  local original_path=$PATH safe_path="" directory name resolved
  local required="mkdir chmod rm rmdir sed head tail mktemp cp mv ln grep stat find awk tr date df id readlink env sort wc"
  IFS=':' read -r -a path_directories <<< "$original_path"
  for directory in "${path_directories[@]}"; do
    case "$directory" in
      /*) safe_path=${safe_path:+$safe_path:}$directory ;;
    esac
  done
  [ -n "$safe_path" ] || refuse "PATH contains no absolute executable directory"
  PATH=$safe_path
  export PATH
  for name in $required; do
    resolved=$(command -v "$name" 2>/dev/null || true)
    case "$resolved" in
      /*) [ -x "$resolved" ] || refuse "$name is not executable" ;;
      *) refuse "$name is required in an absolute PATH directory" ;;
    esac
    hash -p "$resolved" "$name"
    [ "$name" != env ] || env_path=$resolved
  done
  for name in docker openssl sha256sum shasum curl; do
    resolved=$(command -v "$name" 2>/dev/null || true)
    case "$resolved" in
      /*)
        if [ -x "$resolved" ]; then
          hash -p "$resolved" "$name"
          printf -v "${name}_path" '%s' "$resolved"
        fi
        ;;
    esac
  done
}

prepare_docker_command() {
  local name value
  [ -n "$docker_path" ] || refuse "docker is required"
  docker_command=("$env_path" -i "PATH=$PATH")
  for name in HOME DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG DOCKER_TLS_VERIFY DOCKER_CERT_PATH \
    XDG_RUNTIME_DIR XDG_CONFIG_HOME TMPDIR; do
    value=${!name:-}
    [ -z "$value" ] || docker_command+=("$name=$value")
  done
  docker_command+=("$docker_path")
}

prepare_executables

cleanup() {
  local result=$?
  if [ "$restore_cleanup_active" = true ] && [ "${#restore_compose[@]}" -gt 0 ]; then
    "${restore_compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
  fi
  if [ "$mail_restart_required" = true ] && [ "${#mail_restart_compose[@]}" -gt 0 ]; then
    if "${mail_restart_compose[@]}" up -d --wait mail >/dev/null 2>&1; then
      rm -f -- "$installation_directory/.courtside-mail-backup-interrupted"
    fi
  fi
  if [ -n "$temporary_path" ]; then
    chmod -R u+w "$temporary_path" 2>/dev/null || true
    rm -rf -- "$temporary_path"
  fi
  if [ "$owns_lock" = true ] && [ -n "$lock_directory" ]; then
    rm -f -- "$lock_directory/owner"
    rmdir -- "$lock_directory" 2>/dev/null || true
  fi
  owns_lock=false
  exit "$result"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

contains_word() {
  case " $1 " in
    *" $2 "*) return 0 ;;
  esac
  return 1
}

absolute_installation_directory() {
  local requested=$1 parent base
  case "$requested" in
    */../* | */.. | ../* | ..) refuse "installation directory must not contain .." ;;
  esac
  case "$requested" in
    /*) ;;
    *) requested="$PWD/$requested" ;;
  esac
  parent=${requested%/*}
  base=${requested##*/}
  [ -n "$base" ] && [ "$base" != "." ] || refuse "installation directory needs a final name"
  [ -d "$parent" ] || refuse "installation directory parent $parent does not exist"
  parent="$(cd "$parent" && pwd -P)"
  installation_directory="$parent/$base"
  if [ -L "$installation_directory" ]; then
    refuse "installation directory must not be a symbolic link"
  fi
}

infer_installation_directory() {
  case "$script_directory" in
    */releases/*) installation_directory=${script_directory%/releases/*} ;;
    *) installation_directory=$PWD ;;
  esac
  absolute_installation_directory "$installation_directory"
}

acquire_lock() {
  local owner child marker entry
  mkdir -p -- "$installation_directory"
  [[ "$installation_directory" != *$'\n'* ]] && [[ "$installation_directory" != *$'\r'* ]] \
    || refuse "installation directory must not contain control characters"
  for child in releases config secrets backups; do
    [ ! -L "$installation_directory/$child" ] \
      || refuse "$installation_directory/$child must not be a symbolic link"
  done
  lock_directory="$installation_directory/.courtside.lock"
  [ ! -L "$lock_directory" ] || refuse "$lock_directory must not be a symbolic link"
  if ! mkdir -- "$lock_directory" 2>/dev/null; then
    owner=$(sed -n '1p' "$lock_directory/owner" 2>/dev/null || true)
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f -- "$lock_directory/owner"
      rmdir -- "$lock_directory" 2>/dev/null \
        || refuse "stale command lock $lock_directory could not be recovered"
      mkdir -- "$lock_directory"
    else
      refuse "another Courtside command holds $lock_directory"
    fi
  fi
  owns_lock=true
  chmod 700 "$lock_directory"
  printf '%s\n' "$$" > "$lock_directory/owner"
  chmod 600 "$lock_directory/owner"
  marker="$installation_directory/.courtside-installation"
  if [ -e "$marker" ] || [ -L "$marker" ]; then
    [ -f "$marker" ] && [ ! -L "$marker" ] || refuse "$marker must be a regular file"
    [ "$(path_mode "$marker")" = 600 ] && [ "$(path_owner "$marker")" = "$(id -u)" ] \
      || refuse "$marker must be owned by the operator with mode 0600"
    [ "$(sed -n '1p' "$marker")" = "schema=1" ] \
      && [ "$(sed -n '2p' "$marker")" = "root=$installation_directory" ] \
      && [ "$(sed -n '3p' "$marker")" = "" ] \
      || refuse "$marker does not identify this installation root"
  else
    while IFS= read -r -d '' entry; do
      case "${entry##*/}" in
        .courtside.lock | releases | config | secrets | backups | current) ;;
        *) refuse "installation directory is not an empty or recognized Courtside root: ${entry##*/}" ;;
      esac
    done < <(find "$installation_directory" -mindepth 1 -maxdepth 1 -print0)
    if [ -d "$installation_directory/config" ] \
      && [ ! -f "$installation_directory/config/installation.conf" ]; then
      refuse "installation directory has unrecognized configuration state"
    fi
    printf 'schema=1\nroot=%s\n' "$installation_directory" > "$marker"
    chmod 600 "$marker"
  fi
  chmod 700 "$installation_directory"
  cleanup_abandoned_staging
  recover_configuration_transaction
  if [ -e "$installation_directory/.courtside-rotation" ] \
    && [ "${command:-}" != rotate-secret ]; then
    refuse "an interrupted secret rotation requires rotate-secret recovery before other commands"
  fi
}

cleanup_abandoned_staging() {
  local path
  for path in "$installation_directory"/.transaction.partial.* \
    "$installation_directory"/.config.partial.* \
    "$installation_directory"/.rotation.partial.* \
    "$installation_directory"/.rotation.complete.* \
    "$installation_directory"/.mail-marker.partial.* \
    "$installation_directory"/releases/.*.partial.* \
    "$installation_directory"/config/.*.transaction.* \
    "$installation_directory"/config/.env.partial.* \
    "$installation_directory"/config/installation.conf.partial.* \
    "$installation_directory"/secrets/.database-*.partial.*; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    if [ -d "$path" ] && [ ! -L "$path" ]; then
      chmod -R u+w "$path" 2>/dev/null || true
      rm -rf -- "$path"
    else
      rm -f -- "$path"
    fi
  done
}

apply_configuration_transaction() {
  local transaction="$installation_directory/.courtside-transaction" name source destination pending entry
  [ -d "$transaction" ] && [ ! -L "$transaction" ] \
    || refuse "$transaction must be a private transaction directory"
  for entry in "$transaction"/* "$transaction"/.[!.]*; do
    [ -e "$entry" ] || continue
    [ -f "$entry" ] && [ ! -L "$entry" ] || refuse "$transaction contains an unsafe entry"
    case "${entry##*/}" in
      .env | installation.conf | remove-bootstrap | current-release) ;;
      *) refuse "$transaction contains an unknown entry" ;;
    esac
  done
  for name in .env installation.conf; do
    source="$transaction/$name"
    [ -f "$source" ] || continue
    destination="$installation_directory/config/$name"
    pending=$(mktemp "$installation_directory/config/.$name.transaction.XXXXXX")
    temporary_path=$pending
    cp "$source" "$pending"
    chmod 600 "$pending"
    mv "$pending" "$destination"
    temporary_path=""
  done
  if [ -f "$transaction/current-release" ]; then
    pending=$(sed -n '1p' "$transaction/current-release")
    [[ "$pending" =~ ^[0-9A-Za-z.+-]+$ ]] || refuse "$transaction carries an invalid current release"
    [ -d "$installation_directory/releases/$pending" ] \
      || refuse "$transaction names a release that is not installed"
    publish_current_release "$pending"
  fi
  if [ -f "$transaction/remove-bootstrap" ]; then
    rm -f -- "$installation_directory/secrets/bootstrap-admin-password"
  fi
  rm -f -- "$transaction/.env" "$transaction/installation.conf" "$transaction/remove-bootstrap" \
    "$transaction/current-release"
  rmdir -- "$transaction"
}

recover_configuration_transaction() {
  local transaction="$installation_directory/.courtside-transaction"
  [ ! -L "$transaction" ] || refuse "$transaction must not be a symbolic link"
  [ ! -e "$transaction" ] || apply_configuration_transaction
}

json_value() {
  local file=$1 key=$2
  sed -n "s/^[[:space:]]*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\"[,]*[[:space:]]*$/\1/p" "$file" \
    | head -n 1
}

read_manifest() {
  local manifest=$1
  [ -f "$manifest" ] || refuse "$manifest is missing"
  manifest_version=$(json_value "$manifest" version)
  manifest_revision=$(json_value "$manifest" revision)
  manifest_image=$(json_value "$manifest" image)
  manifest_signer=$(json_value "$manifest" signer)
  [[ "$manifest_version" =~ ^[0-9A-Za-z.+-]+$ ]] || refuse "manifest carries an invalid version"
  [[ "$manifest_revision" =~ ^[0-9a-f]{40}$ ]] || refuse "manifest carries an invalid revision"
  [[ "$manifest_image" =~ @sha256:([0-9a-f]{64})$ ]] || refuse "manifest image is not digest-pinned"
  manifest_digest=${BASH_REMATCH[1]}
  if [[ "$manifest_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+-nightly\.[1-9][0-9]*$ ]]; then
    [ "$manifest_signer" = "https://github.com/jegr78/courtside/.github/workflows/nightly-image.yml@refs/heads/main" ] \
      || refuse "manifest signer does not bind nightly $manifest_version"
  else
    [ "$manifest_signer" = "https://github.com/jegr78/courtside/.github/workflows/release.yml@refs/tags/v$manifest_version" ] \
      || refuse "manifest signer does not bind release $manifest_version"
  fi
  manifest_sha256=$(file_digest "$manifest") || refuse "cannot digest $manifest"
}

file_digest() {
  if [ -n "$sha256sum_path" ]; then
    "$sha256sum_path" "$1" | awk '{ print $1 }'
  elif [ -n "$shasum_path" ]; then
    "$shasum_path" -a 256 "$1" | awk '{ print $1 }'
  else
    printf 'neither sha256sum nor shasum is available\n' >&2
    return 1
  fi
}

manifest_declares() {
  local entries=$1 wanted=$2 declared
  while IFS=' ' read -r declared _; do
    [ "$declared" != "$wanted" ] || return 0
  done <<< "$entries"
  return 1
}

verify_release() {
  local root=$1 require_immutable=${2:-true} entries path expected actual declared_count=0 actual_count=0 mode
  entries=$(sed -n 's/^    "\([^"]*\)": "\([0-9a-f]\{64\}\)"[,]*$/\1 \2/p' "$root/manifest.json")
  [ -n "$entries" ] || { printf 'manifest has no file inventory\n' >&2; return 1; }
  while IFS=' ' read -r path expected; do
    [[ "$path" =~ ^[A-Za-z0-9._/-]+$ ]] && [[ "$path" != /* ]] \
      && [[ "/$path/" != */../* ]] \
      || { printf 'manifest has an unsafe file path\n' >&2; return 1; }
    [ -f "$root/$path" ] && [ ! -L "$root/$path" ] \
      || { printf '%s is missing or not a regular release file\n' "$path" >&2; return 1; }
    actual=$(file_digest "$root/$path") || return 1
    [ "$actual" = "$expected" ] \
      || { printf '%s does not match its manifest digest\n' "$path" >&2; return 1; }
    declared_count=$((declared_count + 1))
  done <<< "$entries"
  while IFS= read -r actual; do
    path=${actual#"$root"/}
    [ "$path" = manifest.json ] && continue
    [[ "$path" =~ ^[A-Za-z0-9._/-]+$ ]] \
      || { printf 'release contains an unsafe file path\n' >&2; return 1; }
    manifest_declares "$entries" "$path" \
      || { printf '%s is not declared by the manifest\n' "$path" >&2; return 1; }
    actual_count=$((actual_count + 1))
  done < <(find "$root" -type f -print)
  [ "$actual_count" -eq "$declared_count" ] \
    || { printf 'release file count does not match its manifest\n' >&2; return 1; }
  if [ -n "$(find "$root" -type l -print -quit)" ]; then
    printf 'release contains a symbolic link\n' >&2
    return 1
  fi
  if [ "$require_immutable" = true ]; then
    while IFS= read -r path; do
      mode=$(path_mode "$path")
      [ $((8#$mode & 0222)) -eq 0 ] \
        || { printf 'release path is writable: %s\n' "${path#"$root"/}" >&2; return 1; }
    done < <(find "$root" -print)
  fi
}

answer_defaults() {
  answer_schema=1
  answer_recipe=standard
  answer_overlays=""
  answer_synthetic_mail=false
  answer_rootless_port_start=""
  answer_project=courtside
  answer_domain=""
  answer_bootstrap_username=""
  answer_bootstrap_display_name=""
  answer_source_url=""
  answer_mail_domain=""
  answer_mail_reply_to=""
  answer_mail_relay_host=""
  answer_mail_relay_username=""
  answer_database_url=""
  answer_database_username=""
  answer_custom_image_repository=""
  answer_custom_image_digest=""
  answer_recovery_material=included
}

answer_key() {
  local key=$1 value=$2
  if [[ "$key" =~ (password|passwd|secret|token|credential|private_key) ]]; then
    refuse "answer files contain decisions, never secrets: $key"
  fi
  case "$key" in
    schema) answer_schema=$value ;;
    recipe) answer_recipe=$value ;;
    overlays) answer_overlays=$value ;;
    synthetic_mail) answer_synthetic_mail=$value ;;
    rootless_port_start) answer_rootless_port_start=$value ;;
    project) answer_project=$value ;;
    domain) answer_domain=$value ;;
    bootstrap_username) answer_bootstrap_username=$value ;;
    bootstrap_display_name) answer_bootstrap_display_name=$value ;;
    source_url) answer_source_url=$value ;;
    mail_domain) answer_mail_domain=$value ;;
    mail_reply_to) answer_mail_reply_to=$value ;;
    mail_relay_host) answer_mail_relay_host=$value ;;
    mail_relay_username) answer_mail_relay_username=$value ;;
    database_url) answer_database_url=$value ;;
    database_username) answer_database_username=$value ;;
    custom_image_repository) answer_custom_image_repository=$value ;;
    custom_image_digest) answer_custom_image_digest=$value ;;
    recovery_material) answer_recovery_material=$value ;;
    *) refuse "unknown answer key $key" ;;
  esac
}

read_answers() {
  local file=$1 line key value number=0 seen=""
  [ -f "$file" ] || refuse "answer file $file does not exist"
  while IFS= read -r line || [ -n "$line" ]; do
    number=$((number + 1))
    [[ ! "$line" =~ [[:cntrl:]] ]] || refuse "answer file line $number contains a control character"
    case "$line" in
      "" | "#"*) continue ;;
    esac
    [[ "$line" =~ ^([a-z][a-z0-9_]*)=(.*)$ ]] || refuse "answer file line $number is malformed"
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    contains_word "$seen" "$key" && refuse "answer key $key is declared twice"
    seen="$seen $key"
    answer_key "$key" "$value"
  done < "$file"
}

read_interactive_answers() {
  read -r -p "Recipe [standard]: " answer_recipe
  answer_recipe=${answer_recipe:-standard}
  read -r -p "Docker Compose project: " answer_project
  read -r -p "Public domain: " answer_domain
  read -r -p "Bootstrap administrator username: " answer_bootstrap_username
  read -r -p "Bootstrap administrator display name: " answer_bootstrap_display_name
  read -r -p "Source URL: " answer_source_url
  read -r -p "Mail domain: " answer_mail_domain
  read -r -p "Mail reply-to address: " answer_mail_reply_to
  read -r -p "SMTP relay host: " answer_mail_relay_host
  read -r -p "SMTP relay username, empty for none: " answer_mail_relay_username
}

validate_answers() {
  local require_bootstrap=${1:-true}
  [ "$answer_schema" = "$configuration_schema" ] \
    || refuse "answer file is schema $answer_schema, and this command reads schema $configuration_schema"
  [[ "$answer_recipe" =~ ^[a-z][a-z-]*$ ]] || refuse "invalid recipe $answer_recipe"
  [[ "$answer_project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || refuse "invalid project $answer_project"
  [[ "$answer_overlays" =~ ^$|^[a-z][a-z-]*(,[a-z][a-z-]*)*$ ]] || refuse "overlays must be comma-separated names"
  contains_word "true false" "$answer_synthetic_mail" || refuse "synthetic_mail must be true or false"
  contains_word "included external-verified" "$answer_recovery_material" \
    || refuse "recovery_material must be included or external-verified"
  if [ -n "$answer_rootless_port_start" ]; then
    [[ "$answer_rootless_port_start" =~ ^[0-9]{1,5}$ ]] && [ "$answer_rootless_port_start" -le 65535 ] \
      || refuse "rootless_port_start must be a port"
  fi
  [[ "$answer_domain" =~ ^[A-Za-z0-9.-]+$ ]] || refuse "domain must be a DNS name"
  if [ "$require_bootstrap" = true ]; then
    [[ "$answer_bootstrap_username" =~ ^[A-Za-z0-9._@+-]+$ ]] || refuse "bootstrap_username is invalid"
    [ -n "$answer_bootstrap_display_name" ] && [[ "$answer_bootstrap_display_name" != *$'\n'* ]] \
      && [[ "$answer_bootstrap_display_name" != *$'\r'* ]] \
      || refuse "bootstrap_display_name is invalid"
  fi
  [[ "$answer_source_url" =~ ^https?://[^/@:]+(:[0-9]+)?(/.*)?$ ]] \
    || refuse "source_url must be an absolute HTTP or HTTPS URL without credentials"
  [[ "$answer_mail_domain" =~ ^[A-Za-z0-9.-]+$ ]] || refuse "mail_domain must be a DNS name"
  [[ "$answer_mail_reply_to" =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]] || refuse "mail_reply_to must be an address"
  [ -n "$answer_mail_relay_host" ] || [ "$answer_recipe" = full-self-hosted ] \
    || refuse "mail_relay_host is required for $answer_recipe"
  if [ "$answer_recipe" = existing-infrastructure ]; then
    [[ "$answer_database_url" =~ ^jdbc:postgresql://[^[:space:]]+$ ]] \
      || refuse "database_url must be a PostgreSQL JDBC URL"
    [[ "$answer_database_username" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]] \
      || refuse "database_username is invalid"
  fi
  if contains_word "${answer_overlays//,/ }" custom-image; then
    [[ "$answer_custom_image_repository" =~ ^[A-Za-z0-9._:/-]+$ ]] \
      || refuse "custom_image_repository is invalid"
    [[ "$answer_custom_image_digest" =~ ^[0-9a-f]{64}$ ]] \
      || refuse "custom_image_digest must be 64 lowercase hexadecimal characters"
  fi
}

selection_arguments() {
  selection=("$answer_recipe")
  local overlay
  if [ -n "$answer_overlays" ]; then
    selected_overlays=()
    IFS=',' read -r -a selected_overlays <<< "$answer_overlays"
    for overlay in "${selected_overlays[@]}"; do
      selection+=(--overlay "$overlay")
    done
  fi
  [ "$answer_synthetic_mail" = false ] || selection+=(--synthetic-mail)
  [ -z "$answer_rootless_port_start" ] || selection+=(--rootless-port-start "$answer_rootless_port_start")
}

validate_selection() {
  local release_root=$1 error
  selection_arguments
  if ! error=$("$release_root/recipe.sh" files "${selection[@]}" 2>&1); then
    refuse "$error"
  fi
}

confirm() {
  local already_confirmed=$1 response
  [ "$already_confirmed" = true ] && return 0
  read -r -p "Apply this plan? Type yes: " response
  [ "$response" = yes ] || refuse "plan was not confirmed"
}

random_secret() {
  [ -n "$openssl_path" ] || refuse "openssl is required to generate local secrets"
  "$openssl_path" rand -hex 24
}

ensure_secret_file() {
  local path=$1 pending
  [ ! -L "$path" ] || refuse "$path must not be a symbolic link"
  if [ -f "$path" ]; then
    chmod 600 "$path"
    return 0
  fi
  pending=$(mktemp "$installation_directory/secrets/.secret.partial.XXXXXX")
  umask 077
  random_secret > "$pending"
  chmod 600 "$pending"
  mv "$pending" "$path"
}

write_installation_configuration() {
  local destination=$1
  umask 077
  {
    printf 'schema=%s\n' "$configuration_schema"
    printf 'release=%s\n' "$manifest_version"
    printf 'revision=%s\n' "$manifest_revision"
    printf 'image=%s\n' "$manifest_image"
    printf 'release_manifest_sha256=%s\n' "$manifest_sha256"
    printf 'recipe=%s\n' "$answer_recipe"
    printf 'overlays=%s\n' "$answer_overlays"
    printf 'synthetic_mail=%s\n' "$answer_synthetic_mail"
    printf 'rootless_port_start=%s\n' "$answer_rootless_port_start"
    printf 'project=%s\n' "$answer_project"
    printf 'domain=%s\n' "$answer_domain"
    printf 'source_url=%s\n' "$answer_source_url"
    printf 'mail_domain=%s\n' "$answer_mail_domain"
    printf 'mail_reply_to=%s\n' "$answer_mail_reply_to"
    printf 'mail_relay_host=%s\n' "$answer_mail_relay_host"
    printf 'mail_relay_username=%s\n' "$answer_mail_relay_username"
    printf 'database_url=%s\n' "$answer_database_url"
    printf 'database_username=%s\n' "$answer_database_username"
    printf 'custom_image_repository=%s\n' "$answer_custom_image_repository"
    printf 'custom_image_digest=%s\n' "$answer_custom_image_digest"
    printf 'recovery_material=%s\n' "$answer_recovery_material"
  } > "$destination"
  chmod 600 "$destination"
}

environment_line() {
  local key=$1 value=$2 encoded
  [[ "$value" != *$'\n'* ]] && [[ "$value" != *$'\r'* ]] || refuse "$key contains a line break"
  encoded=${value//\\/\\\\}
  encoded=${encoded//\"/\\\"}
  encoded=${encoded//\$/\$\$}
  printf '%s="%s"\n' "$key" "$encoded"
}

docker_environment_line() {
  local key=$1 value=$2
  [[ "$value" != *$'\n'* ]] && [[ "$value" != *$'\r'* ]] || refuse "$key contains a line break"
  printf '%s=%s\n' "$key" "$value"
}

write_initial_environment() {
  local destination=$1 postgres_password bootstrap_password
  postgres_password=$(random_secret)
  bootstrap_password=$(< "$installation_directory/secrets/bootstrap-admin-password")
  umask 077
  {
    environment_line COURTSIDE_IMAGE_DIGEST "$manifest_digest"
    environment_line COURTSIDE_SOURCE_URL "$answer_source_url"
    environment_line COURTSIDE_DOMAIN "$answer_domain"
    environment_line COURTSIDE_BOOTSTRAP_ADMIN_USERNAME "$answer_bootstrap_username"
    environment_line COURTSIDE_BOOTSTRAP_ADMIN_PASSWORD "$bootstrap_password"
    environment_line COURTSIDE_BOOTSTRAP_ADMIN_DISPLAY_NAME "$answer_bootstrap_display_name"
    environment_line COURTSIDE_MAIL_DOMAIN "$answer_mail_domain"
    environment_line COURTSIDE_MAIL_REPLY_TO "$answer_mail_reply_to"
    environment_line COURTSIDE_MAIL_RELAY_HOST "$answer_mail_relay_host"
    environment_line COURTSIDE_MAIL_RELAY_USERNAME "$answer_mail_relay_username"
    if [ "$answer_recipe" = full-self-hosted ]; then
      environment_line COURTSIDE_MAIL_PASSWORD "$(random_secret)"
    elif [ -n "$answer_mail_relay_username" ]; then
      [ -n "${COURTSIDE_MAIL_PASSWORD:-}" ] \
        || refuse "COURTSIDE_MAIL_PASSWORD must be supplied outside the answer file for an authenticated relay"
      environment_line COURTSIDE_MAIL_PASSWORD "$COURTSIDE_MAIL_PASSWORD"
    else
      environment_line COURTSIDE_MAIL_PASSWORD ""
    fi
    if [ "$answer_recipe" = existing-infrastructure ]; then
      [ -n "${COURTSIDE_DATABASE_PASSWORD:-}" ] \
        || refuse "COURTSIDE_DATABASE_PASSWORD must be supplied outside the answer file"
      environment_line POSTGRES_PASSWORD ""
      environment_line COURTSIDE_DATABASE_URL "$answer_database_url"
      environment_line COURTSIDE_DATABASE_USERNAME "$answer_database_username"
      environment_line COURTSIDE_DATABASE_PASSWORD "$COURTSIDE_DATABASE_PASSWORD"
    else
      environment_line POSTGRES_PASSWORD "$postgres_password"
    fi
    if [ "$answer_recipe" = full-self-hosted ]; then
      environment_line COURTSIDE_MAIL_HOSTNAME "mail.$answer_domain"
      environment_line COURTSIDE_MAIL_ADMIN_PASSWORD "$(random_secret)"
      environment_line COURTSIDE_MAIL_SETUP_PASSWORD "$(random_secret)"
      environment_line COURTSIDE_MAIL_RELOAD_PASSWORD "$(random_secret)"
      environment_line COURTSIDE_MAIL_DKIM_SELECTOR courtside
    fi
    if contains_word "${answer_overlays//,/ }" custom-image; then
      environment_line COURTSIDE_CUSTOM_IMAGE_REPOSITORY "$answer_custom_image_repository"
      environment_line COURTSIDE_CUSTOM_IMAGE_DIGEST "$answer_custom_image_digest"
    fi
  } > "$destination"
  chmod 600 "$destination"
}

write_identity_secrets() {
  local environment_file=$1
  contains_word "${answer_overlays//,/ }" database-identities || return 0
  local name path key
  for name in owner migration runtime; do
    path="$installation_directory/secrets/database-$name-password"
    ensure_secret_file "$path"
    case "$name" in
      owner) key=COURTSIDE_DB_OWNER_PASSWORD_FILE ;;
      migration) key=COURTSIDE_DB_MIGRATION_PASSWORD_FILE ;;
      runtime) key=COURTSIDE_DB_RUNTIME_PASSWORD_FILE ;;
    esac
    if ! grep -q "^$key=" "$environment_file"; then
      environment_line "$key" "$path" >> "$environment_file"
    fi
  done
}

publish_release() {
  local source_root=${1:-$script_directory}
  local release_directory="$installation_directory/releases/$manifest_version"
  local expected_version=$manifest_version expected_revision=$manifest_revision expected_image=$manifest_image problem
  local expected_manifest_digest
  expected_manifest_digest=$(file_digest "$source_root/manifest.json") || refuse "cannot digest archive manifest"
  mkdir -p "$installation_directory/releases"
  chmod 700 "$installation_directory/releases"
  [ ! -L "$release_directory" ] || refuse "$release_directory must not be a symbolic link"
  if [ ! -d "$release_directory" ]; then
    temporary_path=$(mktemp -d "$installation_directory/releases/.$manifest_version.partial.XXXXXX")
    cp -R "$source_root"/. "$temporary_path"/
    chmod 700 "$temporary_path"
    chmod -R a-w "$temporary_path"
    if ! problem=$(verify_release "$temporary_path" 2>&1); then
      refuse "release integrity check failed: $problem"
    fi
    mv "$temporary_path" "$release_directory"
    temporary_path=""
  else
    [ "$(file_digest "$release_directory/manifest.json")" = "$expected_manifest_digest" ] \
      || refuse "$release_directory manifest does not match the archive being installed"
    read_manifest "$release_directory/manifest.json"
    [ "$manifest_version" = "$expected_version" ] && [ "$manifest_revision" = "$expected_revision" ] \
      && [ "$manifest_image" = "$expected_image" ] \
      || refuse "$release_directory does not match the archive being installed"
    if ! problem=$(verify_release "$release_directory" 2>&1); then
      refuse "release integrity check failed: $problem"
    fi
  fi
  manifest_version=$expected_version
  manifest_revision=$expected_revision
  manifest_image=$expected_image
  manifest_digest=${expected_image##*@sha256:}
}

publish_initial_configuration() {
  local config_directory="$installation_directory/config"
  mkdir -p "$installation_directory/secrets" "$installation_directory/backups"
  chmod 700 "$installation_directory/secrets" "$installation_directory/backups"
  if [ ! -d "$config_directory" ]; then
    ensure_secret_file "$installation_directory/secrets/bootstrap-admin-password"
    temporary_path=$(mktemp -d "$installation_directory/.config.partial.XXXXXX")
    chmod 700 "$temporary_path"
    write_installation_configuration "$temporary_path/installation.conf"
    write_initial_environment "$temporary_path/.env"
    write_identity_secrets "$temporary_path/.env"
    mv "$temporary_path" "$config_directory"
    temporary_path=""
  fi
}

publish_current() {
  publish_current_release "$manifest_version"
}

publish_current_release() {
  local release=$1 candidate="$installation_directory/.current.$$"
  ln -s "releases/$release" "$candidate"
  if mv -Tf "$candidate" "$installation_directory/current" 2>/dev/null; then
    return 0
  fi
  if mv -fh "$candidate" "$installation_directory/current" 2>/dev/null; then
    return 0
  fi
  rm -f -- "$candidate"
  refuse "current release link could not be replaced atomically"
}

load_configuration() {
  local file="$installation_directory/config/installation.conf" line key value seen="" number=0
  local bundled_database_material
  [ -f "$file" ] || refuse "$file is missing"
  [ ! -L "$installation_directory/config" ] && [ ! -L "$file" ] \
    && [ ! -L "$installation_directory/config/.env" ] \
    || refuse "installation configuration must not use symbolic links"
  [ ! -L "$installation_directory/secrets" ] && [ ! -L "$installation_directory/backups" ] \
    && [ ! -L "$installation_directory/releases" ] \
    || refuse "installation state directories must not use symbolic links"
  validate_environment_file "$installation_directory/config/.env"
  config_schema=""
  config_release=""
  config_revision=""
  config_image=""
  config_release_manifest_sha256=""
  config_recipe=""
  config_overlays=""
  config_synthetic_mail=""
  config_rootless_port_start=""
  config_project=""
  config_domain=""
  config_source_url=""
  config_mail_domain=""
  config_mail_reply_to=""
  config_mail_relay_host=""
  config_mail_relay_username=""
  config_database_url=""
  config_database_username=""
  config_custom_image_repository=""
  config_custom_image_digest=""
  config_recovery_material=""
  while IFS= read -r line || [ -n "$line" ]; do
    number=$((number + 1))
    [[ ! "$line" =~ [[:cntrl:]] ]] \
      || refuse "installation.conf line $number contains a control character"
    [[ "$line" =~ ^([a-z][a-z0-9_]*)=(.*)$ ]] || refuse "installation.conf line $number is malformed"
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    contains_word "$seen" "$key" && refuse "installation.conf declares $key twice"
    seen="$seen $key"
    case "$key" in
      schema) config_schema=$value ;;
      release) config_release=$value ;;
      revision) config_revision=$value ;;
      image) config_image=$value ;;
      release_manifest_sha256) config_release_manifest_sha256=$value ;;
      recipe) config_recipe=$value ;;
      overlays) config_overlays=$value ;;
      synthetic_mail) config_synthetic_mail=$value ;;
      rootless_port_start) config_rootless_port_start=$value ;;
      project) config_project=$value ;;
      domain) config_domain=$value ;;
      source_url) config_source_url=$value ;;
      mail_domain) config_mail_domain=$value ;;
      mail_reply_to) config_mail_reply_to=$value ;;
      mail_relay_host) config_mail_relay_host=$value ;;
      mail_relay_username) config_mail_relay_username=$value ;;
      database_url) config_database_url=$value ;;
      database_username) config_database_username=$value ;;
      custom_image_repository) config_custom_image_repository=$value ;;
      custom_image_digest) config_custom_image_digest=$value ;;
      recovery_material) config_recovery_material=$value ;;
      *) refuse "installation.conf has unknown key $key" ;;
    esac
  done < "$file"
  [ -n "$config_recovery_material" ] || config_recovery_material=included
  [ "$config_schema" = "$configuration_schema" ] \
    || refuse "installation.conf is schema $config_schema, and this command reads schema $configuration_schema"
  [[ "$config_release" =~ ^[0-9A-Za-z.+-]+$ ]] || refuse "installation.conf has an invalid release"
  [[ "$config_revision" =~ ^[0-9a-f]{40}$ ]] || refuse "installation.conf has an invalid revision"
  [[ "$config_image" =~ @sha256:[0-9a-f]{64}$ ]] || refuse "installation.conf has an invalid image"
  [[ "$config_release_manifest_sha256" =~ ^[0-9a-f]{64}$ ]] \
    || refuse "installation.conf has an invalid release manifest digest"
  answer_schema=$config_schema
  answer_bootstrap_username=""
  answer_bootstrap_display_name=""
  answer_recipe=$config_recipe
  answer_overlays=$config_overlays
  answer_synthetic_mail=$config_synthetic_mail
  answer_rootless_port_start=$config_rootless_port_start
  answer_project=$config_project
  answer_domain=$config_domain
  answer_source_url=$config_source_url
  answer_mail_domain=$config_mail_domain
  answer_mail_reply_to=$config_mail_reply_to
  answer_mail_relay_host=$config_mail_relay_host
  answer_mail_relay_username=$config_mail_relay_username
  answer_database_url=$config_database_url
  answer_database_username=$config_database_username
  answer_custom_image_repository=$config_custom_image_repository
  answer_custom_image_digest=$config_custom_image_digest
  answer_recovery_material=$config_recovery_material
  manifest_version=$config_release
  manifest_revision=$config_revision
  manifest_image=$config_image
  manifest_digest=${config_image##*@sha256:}
  manifest_sha256=$config_release_manifest_sha256
  validate_answers false
  if [ "$config_recipe" != existing-infrastructure ]; then
    bundled_database_material=$(environment_value "$installation_directory/config/.env" POSTGRES_PASSWORD)
    [[ "$bundled_database_material" =~ ^[0-9a-f]{48}$ ]] \
      || refuse "bundled PostgreSQL password must be a generated 48-character hexadecimal value"
  fi
}

validate_installed_release() {
  local release_root="$installation_directory/releases/$config_release" problem actual_manifest_sha256
  [ -L "$installation_directory/current" ] \
    && [ "$(readlink "$installation_directory/current")" = "releases/$config_release" ] \
    || refuse "$installation_directory/current does not select releases/$config_release"
  actual_manifest_sha256=$(file_digest "$release_root/manifest.json") \
    || refuse "cannot digest $release_root/manifest.json"
  [ "$actual_manifest_sha256" = "$config_release_manifest_sha256" ] \
    || refuse "$release_root manifest does not match installation.conf"
  read_manifest "$release_root/manifest.json"
  [ "$manifest_version" = "$config_release" ] && [ "$manifest_revision" = "$config_revision" ] \
    && [ "$manifest_image" = "$config_image" ] \
    || refuse "$release_root does not match installation.conf"
  if ! problem=$(verify_release "$release_root" 2>&1); then
    refuse "release integrity check failed: $problem"
  fi
}

compose_command() {
  load_configuration
  local release_root="$installation_directory/current" file
  validate_installed_release
  [ ! -L "$installation_directory/config/local.override.yaml" ] \
    || refuse "config/local.override.yaml must not be a symbolic link"
  validate_environment_images
  validate_selection "$release_root"
  prepare_docker_command
  compose=("${docker_command[@]}" compose --project-name "$config_project" --project-directory "$release_root"
    --env-file "$installation_directory/config/.env")
  selection_arguments
  compose_files=()
  while IFS= read -r file; do
    compose_files+=("$file")
  done < <("$release_root/recipe.sh" files "${selection[@]}")
  for file in "${compose_files[@]}"; do
    compose+=(-f "$release_root/$file")
  done
  if [ -f "$installation_directory/config/local.override.yaml" ]; then
    compose+=(-f "$installation_directory/config/local.override.yaml")
  fi
  if [ -f "$installation_directory/.courtside-mail-backup-interrupted" ]; then
    [ ! -L "$installation_directory/.courtside-mail-backup-interrupted" ] \
      || refuse "mail backup recovery marker must not be a symbolic link"
    [ "$config_recipe" = full-self-hosted ] \
      || refuse "mail backup recovery marker exists for a recipe without managed mail"
    "${compose[@]}" up -d --wait mail \
      || refuse "Stalwart is still stopped after an interrupted backup"
    rm -f -- "$installation_directory/.courtside-mail-backup-interrupted"
  fi
}

write_recovery_checksums() {
  local root=$1 path digest
  : > "$root/SHA256SUMS"
  while IFS= read -r path; do
    path=${path#./}
    digest=$(file_digest "$root/$path") || refuse "cannot digest recovery file $path"
    printf '%s  %s\n' "$digest" "$path" >> "$root/SHA256SUMS"
  done < <(cd "$root" && find . -type f ! -name SHA256SUMS -print | sort)
  chmod 600 "$root/SHA256SUMS"
}

recovery_value() {
  local file=$1 key=$2
  sed -n "s/^$key=\(.*\)$/\1/p" "$file" | head -n 1
}

recovery_declares() {
  local entries=$1 wanted=$2 expected declared
  while IFS=' ' read -r expected declared; do
    [ "$declared" != "$wanted" ] || return 0
  done <<< "$entries"
  return 1
}

recovery_timestamp_epoch() {
  local timestamp=$1 epoch normalized
  [[ "$timestamp" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || return 1
  normalized="${timestamp:0:4}-${timestamp:4:2}-${timestamp:6:2}T${timestamp:9:2}:${timestamp:11:2}:${timestamp:13:2}Z"
  if epoch=$(date -u -d "$normalized" +%s 2>/dev/null); then
    :
  elif epoch=$(date -u -j -f '%Y%m%dT%H%M%SZ' "$timestamp" +%s 2>/dev/null); then
    :
  else
    return 1
  fi
  [[ "$epoch" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$epoch"
}

verify_recovery_unit() {
  local root=$1 entries expected path actual declared_count=0 actual_count=0 file
  local recovery_created_at recovery_created_epoch now
  [ -d "$root" ] && [ ! -L "$root" ] || refuse "$root is not a recovery directory"
  [ "$(path_mode "$root")" = 700 ] && [ "$(path_owner "$root")" = "$(id -u)" ] \
    || refuse "$root must be an operator-owned mode-0700 recovery directory"
  [ -f "$root/recovery.conf" ] && [ -f "$root/SHA256SUMS" ] \
    || refuse "$root is not a complete recovery unit"
  [ ! -L "$root/recovery.conf" ] && [ ! -L "$root/SHA256SUMS" ] \
    || refuse "$root recovery metadata must not use symbolic links"
  entries=$(< "$root/SHA256SUMS")
  [ -n "$entries" ] || refuse "$root has no recovery checksums"
  while IFS=' ' read -r expected path; do
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] \
      && [[ "$path" =~ ^[A-Za-z0-9._/-]+$ ]] && [[ "$path" != /* ]] \
      && [[ "/$path/" != */../* ]] \
      || refuse "$root has an unsafe recovery checksum entry"
    [ -f "$root/$path" ] && [ ! -L "$root/$path" ] \
      || refuse "$root recovery checksum names a missing or unsafe file"
    actual=$(file_digest "$root/$path") || refuse "cannot digest recovery file $path"
    [ "$actual" = "$expected" ] || refuse "recovery checksum failed for $path"
    declared_count=$((declared_count + 1))
  done <<< "$entries"
  while IFS= read -r file; do
    path=${file#"$root"/}
    [ "$path" = SHA256SUMS ] && continue
    recovery_declares "$entries" "$path" || refuse "recovery file $path has no checksum"
    actual_count=$((actual_count + 1))
  done < <(find "$root" -type f -print)
  [ "$actual_count" -eq "$declared_count" ] || refuse "$root recovery file count is inconsistent"
  [ -z "$(find "$root" -type l -print -quit)" ] || refuse "$root recovery unit contains a symbolic link"
  recovery_schema=$(recovery_value "$root/recovery.conf" schema)
  recovery_release=$(recovery_value "$root/recovery.conf" release)
  recovery_revision=$(recovery_value "$root/recovery.conf" revision)
  recovery_image=$(recovery_value "$root/recovery.conf" image)
  recovery_image_trust=$(recovery_value "$root/recovery.conf" image_trust)
  recovery_recipe=$(recovery_value "$root/recovery.conf" recipe)
  recovery_created_at=$(recovery_value "$root/recovery.conf" created_at)
  [ "$recovery_schema" = 1 ] || refuse "$root uses an unsupported recovery schema"
  [[ "$recovery_release" =~ ^[0-9A-Za-z.+-]+$ ]] || refuse "$root has an invalid recovery release"
  [[ "$recovery_revision" =~ ^[0-9a-f]{40}$ ]] || refuse "$root has an invalid recovery revision"
  [[ "$recovery_image" =~ @sha256:[0-9a-f]{64}$ ]] || refuse "$root has an invalid recovery image"
  contains_word "official custom" "$recovery_image_trust" \
    || refuse "$root has an invalid recovery image trust mode"
  recovery_created_epoch=$(recovery_timestamp_epoch "$recovery_created_at") \
    || refuse "$root has an invalid recovery creation timestamp"
  now=$(date +%s)
  [ "$recovery_created_epoch" -le "$now" ] \
    || refuse "$root has a future recovery creation timestamp"
  [ -f "$root/database.dump" ] || refuse "$root has no PostgreSQL dump"
  [ -f "$root/release/manifest.json" ] || refuse "$root has no release archive"
}

postgres_image() {
  local image
  image=$(sed -n 's/^[[:space:]]*image: \(postgres:17-alpine@sha256:[0-9a-f]\{64\}\)$/\1/p' \
    "$installation_directory/current/compose.yaml" | head -n 1)
  [[ "$image" =~ ^postgres:17-alpine@sha256:[0-9a-f]{64}$ ]] \
    || refuse "the installed release has no pinned PostgreSQL 17 image"
  printf '%s' "$image"
}

database_backup() {
  local destination=$1 image connection authority database host port pg_environment
  compose_command
  if [ "$config_recipe" != existing-infrastructure ]; then
    "${compose[@]}" exec -T db pg_dump --format=custom --no-owner -U courtside courtside > "$destination"
    "${compose[@]}" exec -T db pg_restore --list < "$destination" >/dev/null
    return 0
  fi
  connection=${config_database_url#jdbc:postgresql://}
  authority=${connection%%/*}
  database=${connection#*/}
  database=${database%%\?*}
  host=${authority%%:*}
  port=${authority#*:}
  [ "$port" != "$authority" ] || port=5432
  [[ "$host" =~ ^[A-Za-z0-9.-]+$ ]] && [[ "$port" =~ ^[0-9]+$ ]] \
    && [[ "$database" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] \
    || refuse "external database URL cannot be represented safely for backup"
  pg_environment=$(mktemp "$installation_directory/.pg-backup.XXXXXX")
  temporary_path=$pg_environment
  chmod 600 "$pg_environment"
  docker_environment_line PGPASSWORD "$(environment_value "$installation_directory/config/.env" COURTSIDE_DATABASE_PASSWORD)" \
    > "$pg_environment"
  image=$(postgres_image)
  "${docker_command[@]}" run --rm --network host --env-file "$pg_environment" "$image" \
    pg_dump --format=custom --no-owner --host "$host" --port "$port" \
    --username "$config_database_username" "$database" > "$destination"
  "${docker_command[@]}" run --rm --network none "$image" pg_restore --list < "$destination" >/dev/null
  rm -f -- "$pg_environment"
  temporary_path=""
}

backup_mail_stores() {
  local root=$1 helper volume failed=false marker marker_staging
  [ "$config_recipe" = full-self-hosted ] || return 0
  helper=$(sed -n 's/^[[:space:]]*image: \(alpine:3@sha256:[0-9a-f]\{64\}\)$/\1/p' \
    "$installation_directory/current/compose.stalwart.yaml" | head -n 1)
  [[ "$helper" =~ ^alpine:3@sha256:[0-9a-f]{64}$ ]] \
    || refuse "the installed release has no pinned mail backup helper"
  marker="$installation_directory/.courtside-mail-backup-interrupted"
  [ ! -e "$marker" ] && [ ! -L "$marker" ] \
    || refuse "mail backup recovery marker already exists"
  marker_staging=$(mktemp "$installation_directory/.mail-marker.partial.XXXXXX")
  printf 'schema=1\n' > "$marker_staging"
  chmod 600 "$marker_staging"
  mv "$marker_staging" "$marker"
  mail_restart_required=true
  mail_restart_compose=("${compose[@]}")
  "${compose[@]}" stop mail
  for volume in mail-config mail-data; do
    if ! "${docker_command[@]}" run --rm --network none \
      --volume "${config_project}_$volume:/source:ro" "$helper" tar -C /source -cf - . \
      > "$root/$volume.tar"; then
      failed=true
      break
    fi
    chmod 600 "$root/$volume.tar"
  done
  if ! "${compose[@]}" up -d --wait mail; then
    refuse "Stalwart did not become healthy after its backup interruption"
  fi
  rm -f -- "$marker"
  mail_restart_required=false
  mail_restart_compose=()
  [ "$failed" = false ] || refuse "Stalwart backup failed; mail was restarted and no recovery unit was published"
}

prune_recovery_units() {
  local retain=$1 path candidate
  local units=()
  while IFS= read -r path; do units+=("$path"); done \
    < <(printf '%s\n' "$installation_directory"/backups/recovery-* | sort)
  [ "${units[0]:-}" != "$installation_directory/backups/recovery-*" ] || return 0
  while [ "${#units[@]}" -gt "$retain" ]; do
    candidate=${units[0]}
    verify_recovery_unit "$candidate"
    case "$candidate" in
      "$installation_directory"/backups/recovery-*) ;;
      *) refuse "retention resolved outside the configured backup directory" ;;
    esac
    chmod -R u+w "$candidate"
    rm -rf -- "$candidate"
    units=("${units[@]:1}")
  done
}

create_backup() {
  local retain=$1 staging final timestamp path effective_image image_trust=official
  load_configuration
  compose_command
  mkdir -p "$installation_directory/backups"
  chmod 700 "$installation_directory/backups"
  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  staging=$(mktemp -d "$installation_directory/backups/.recovery.partial.XXXXXX")
  temporary_path=$staging
  chmod 700 "$staging"
  database_backup "$staging/database.dump"
  chmod 600 "$staging/database.dump"
  mkdir "$staging/configuration" "$staging/secrets"
  chmod 700 "$staging/configuration" "$staging/secrets"
  cp "$installation_directory/config/installation.conf" "$staging/configuration/installation.conf"
  if [ "$config_recovery_material" = included ]; then
    cp "$installation_directory/config/.env" "$staging/configuration/.env"
  fi
  if [ -f "$installation_directory/config/local.override.yaml" ]; then
    [ ! -L "$installation_directory/config/local.override.yaml" ] \
      || refuse "config/local.override.yaml must not be a symbolic link"
    cp "$installation_directory/config/local.override.yaml" "$staging/configuration/local.override.yaml"
  fi
  if [ "$config_recovery_material" = included ]; then
    for path in "$installation_directory"/secrets/*; do
      [ -e "$path" ] || continue
      [ -f "$path" ] && [ ! -L "$path" ] || refuse "secret material must be regular files"
      cp "$path" "$staging/secrets/${path##*/}"
    done
  fi
  cp -R "$installation_directory/releases/$config_release" "$staging/release"
  backup_mail_stores "$staging"
  effective_image=$config_image
  if contains_word "${config_overlays//,/ }" custom-image; then
    effective_image="$config_custom_image_repository@sha256:$config_custom_image_digest"
    image_trust=custom
  fi
  umask 077
  {
    printf 'schema=1\nrelease=%s\nrevision=%s\nimage=%s\nimage_trust=%s\nrecipe=%s\n' \
      "$config_release" "$config_revision" "$effective_image" "$image_trust" "$config_recipe"
    printf 'created_at=%s\nenvironment=%s\nlocal_override=%s\nmail_state=%s\n' \
      "$timestamp" "$config_recovery_material" \
      "$([ -f "$staging/configuration/local.override.yaml" ] && printf present || printf absent)" \
      "$([ "$config_recipe" = full-self-hosted ] && printf captured || printf external)"
  } > "$staging/recovery.conf"
  printf 'Restore with: %s/current/courtside restore-check --recovery %s/backups/<recovery-unit>\n' \
    "$installation_directory" "$installation_directory" > "$staging/restore-instructions.txt"
  chmod -R go-rwx "$staging"
  write_recovery_checksums "$staging"
  final="$installation_directory/backups/recovery-$timestamp-$config_release-$$"
  mv "$staging" "$final"
  temporary_path=""
  verify_recovery_unit "$final"
  created_recovery=$final
  prune_recovery_units "$retain"
}

command_backup() {
  local retain=7
  while [ $# -gt 0 ]; do
    case "$1" in
      --retain) [ $# -ge 2 ] || refuse "--retain needs a count"; retain=$2; shift 2 ;;
      *) refuse "unknown backup option $1" ;;
    esac
  done
  [[ "$retain" =~ ^[1-9][0-9]*$ ]] || refuse "backup retention must be a positive count"
  acquire_lock
  create_backup "$retain"
  printf 'Recovery unit written to %s\n' "$created_recovery"
}

command_init() {
  local answers_file="" confirmed=false requested_recipe requested_release requested_revision requested_image
  while [ $# -gt 0 ]; do
    case "$1" in
      --answers) [ $# -ge 2 ] || refuse "--answers needs a file"; answers_file=$2; shift 2 ;;
      --yes) confirmed=true; shift ;;
      *) refuse "unknown init option $1" ;;
    esac
  done
  read_manifest "$script_directory/manifest.json"
  answer_defaults
  if [ -n "$answers_file" ]; then read_answers "$answers_file"; else read_interactive_answers; fi
  validate_answers
  validate_selection "$script_directory"
  requested_recipe=$answer_recipe
  requested_release=$manifest_version
  requested_revision=$manifest_revision
  requested_image=$manifest_image
  printf 'Plan: install release %s with recipe %s in %s\n' \
    "$manifest_version" "$answer_recipe" "$installation_directory"
  confirm "$confirmed"
  acquire_lock
  if [ -f "$installation_directory/config/installation.conf" ] && [ -L "$installation_directory/current" ]; then
    load_configuration
    [ "$config_release" = "$requested_release" ] && [ "$config_revision" = "$requested_revision" ] \
      && [ "$config_image" = "$requested_image" ] && [ "$config_recipe" = "$requested_recipe" ] \
      || refuse "installation already exists; use reconfigure for changed decisions"
    [ "$(file_digest "$installation_directory/releases/$config_release/manifest.json")" \
      = "$(file_digest "$script_directory/manifest.json")" ] \
      || refuse "installed release manifest does not match this archive"
    validate_installed_release
    printf 'Installation already matches release %s and recipe %s\n' "$config_release" "$config_recipe"
    return 0
  fi
  publish_release
  publish_initial_configuration
  publish_current
  printf 'Installed release %s. Retrieve the bootstrap password with: cat %q\n' \
    "$manifest_version" "$installation_directory/secrets/bootstrap-admin-password"
}

environment_value() {
  local file=$1 wanted=$2 line value decoded character next index
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$wanted="*)
        value=${line#*=}
        case "$value" in
          \"*\")
            value=${value:1:${#value}-2}
            decoded=""
            index=0
            while [ "$index" -lt "${#value}" ]; do
              character=${value:$index:1}
              next=${value:$((index + 1)):1}
              if [ "$character" = "\\" ] && { [ "$next" = "\\" ] || [ "$next" = '"' ]; }; then
                decoded="$decoded$next"
                index=$((index + 1))
              elif [ "$character" = '$' ] && [ "$next" = '$' ]; then
                decoded="${decoded}\$"
                index=$((index + 1))
              else
                decoded="$decoded$character"
              fi
              index=$((index + 1))
            done
            printf '%s' "$decoded"
            ;;
          *) printf '%s' "$value" ;;
        esac
        return 0
        ;;
    esac
  done < "$file"
}

validate_environment_file() {
  local file=$1 line key seen="" number=0
  [ -f "$file" ] || refuse "$file is missing"
  while IFS= read -r line || [ -n "$line" ]; do
    number=$((number + 1))
    case "$line" in
      "" | "#"*) continue ;;
    esac
    if ! [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=\"([^\"\\\$]|\\[\\\"]|\$\$)*\"$ ]]; then
      refuse ".env line $number is not in canonical KEY=\"value\" form"
    fi
    key=${BASH_REMATCH[1]}
    contains_word "$seen" "$key" && refuse ".env declares $key twice"
    seen="$seen $key"
  done < "$file"
}

validate_environment_images() {
  local file="$installation_directory/config/.env" line key seen="" official custom_repository custom_digest
  while IFS= read -r line || [ -n "$line" ]; do
    key=${line%%=*}
    case "$key" in
      COURTSIDE_IMAGE_DIGEST | COURTSIDE_CUSTOM_IMAGE_REPOSITORY | COURTSIDE_CUSTOM_IMAGE_DIGEST)
        contains_word "$seen" "$key" && refuse ".env declares $key twice"
        seen="$seen $key"
        ;;
      COURTSIDE_*IMAGE*) refuse ".env has unknown image setting $key" ;;
    esac
  done < "$file"
  contains_word "$seen" COURTSIDE_IMAGE_DIGEST || refuse ".env has no COURTSIDE_IMAGE_DIGEST"
  official=$(environment_value "$file" COURTSIDE_IMAGE_DIGEST)
  [ "$official" = "${config_image##*@sha256:}" ] \
    || refuse ".env image digest does not match installation.conf"
  if contains_word "${config_overlays//,/ }" custom-image; then
    if ! contains_word "$seen" COURTSIDE_CUSTOM_IMAGE_REPOSITORY \
      || ! contains_word "$seen" COURTSIDE_CUSTOM_IMAGE_DIGEST; then
      refuse ".env is missing the selected custom image"
    fi
    custom_repository=$(environment_value "$file" COURTSIDE_CUSTOM_IMAGE_REPOSITORY)
    custom_digest=$(environment_value "$file" COURTSIDE_CUSTOM_IMAGE_DIGEST)
    [ "$custom_repository" = "$config_custom_image_repository" ] \
      && [ "$custom_digest" = "$config_custom_image_digest" ] \
      || refuse ".env custom image does not match installation.conf"
  elif contains_word "$seen" COURTSIDE_CUSTOM_IMAGE_REPOSITORY \
    || contains_word "$seen" COURTSIDE_CUSTOM_IMAGE_DIGEST; then
    refuse ".env carries a custom image that installation.conf did not select"
  fi
}

validate_reconfigure_secrets() {
  local file="$installation_directory/config/.env" value
  if [ "$answer_recipe" = existing-infrastructure ]; then
    value=${COURTSIDE_DATABASE_PASSWORD:-}
    [ -n "$value" ] || value=$(environment_value "$file" COURTSIDE_DATABASE_PASSWORD)
    [ -n "$value" ] || refuse "COURTSIDE_DATABASE_PASSWORD must be supplied outside the answer file"
  fi
  if [ "$answer_recipe" != full-self-hosted ] && [ -n "$answer_mail_relay_username" ]; then
    value=${COURTSIDE_MAIL_PASSWORD:-}
    [ -n "$value" ] || value=$(environment_value "$file" COURTSIDE_MAIL_PASSWORD)
    [ -n "$value" ] \
      || refuse "COURTSIDE_MAIL_PASSWORD must be supplied outside the answer file for an authenticated relay"
  fi
}

write_reconfigured_environment() {
  local destination=$1 file="$installation_directory/config/.env" key line
  local postgres_password database_password mail_password mail_admin mail_setup mail_reload
  postgres_password=$(environment_value "$file" POSTGRES_PASSWORD)
  database_password=${COURTSIDE_DATABASE_PASSWORD:-}
  [ -n "$database_password" ] \
    || database_password=$(environment_value "$file" COURTSIDE_DATABASE_PASSWORD)
  mail_password=${COURTSIDE_MAIL_PASSWORD:-}
  [ -n "$mail_password" ] || mail_password=$(environment_value "$file" COURTSIDE_MAIL_PASSWORD)
  mail_admin=$(environment_value "$file" COURTSIDE_MAIL_ADMIN_PASSWORD)
  mail_setup=$(environment_value "$file" COURTSIDE_MAIL_SETUP_PASSWORD)
  mail_reload=$(environment_value "$file" COURTSIDE_MAIL_RELOAD_PASSWORD)
  if [ "$answer_recipe" != existing-infrastructure ] && [ -z "$postgres_password" ]; then
    postgres_password=$(random_secret)
  fi
  if [ "$answer_recipe" = full-self-hosted ]; then
    [ -n "$mail_password" ] || mail_password=$(random_secret)
    [ -n "$mail_admin" ] || mail_admin=$(random_secret)
    [ -n "$mail_setup" ] || mail_setup=$(random_secret)
    [ -n "$mail_reload" ] || mail_reload=$(random_secret)
  fi
  umask 077
  while IFS= read -r line || [ -n "$line" ]; do
    key=${line%%=*}
    case "$key" in
      COURTSIDE_SOURCE_URL | COURTSIDE_DOMAIN | COURTSIDE_MAIL_DOMAIN | COURTSIDE_MAIL_REPLY_TO \
        | COURTSIDE_MAIL_RELAY_HOST | COURTSIDE_MAIL_RELAY_USERNAME | COURTSIDE_MAIL_PASSWORD \
        | POSTGRES_PASSWORD | COURTSIDE_DATABASE_URL | COURTSIDE_DATABASE_USERNAME \
        | COURTSIDE_DATABASE_PASSWORD | COURTSIDE_MAIL_HOSTNAME | COURTSIDE_MAIL_ADMIN_PASSWORD \
        | COURTSIDE_MAIL_SETUP_PASSWORD | COURTSIDE_MAIL_RELOAD_PASSWORD \
        | COURTSIDE_MAIL_DKIM_SELECTOR | COURTSIDE_CUSTOM_IMAGE_REPOSITORY \
        | COURTSIDE_CUSTOM_IMAGE_DIGEST) ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$file" > "$destination"
  {
    environment_line COURTSIDE_SOURCE_URL "$answer_source_url"
    environment_line COURTSIDE_DOMAIN "$answer_domain"
    environment_line COURTSIDE_MAIL_DOMAIN "$answer_mail_domain"
    environment_line COURTSIDE_MAIL_REPLY_TO "$answer_mail_reply_to"
    environment_line COURTSIDE_MAIL_RELAY_HOST "$answer_mail_relay_host"
    environment_line COURTSIDE_MAIL_RELAY_USERNAME "$answer_mail_relay_username"
    environment_line COURTSIDE_MAIL_PASSWORD "$mail_password"
    environment_line POSTGRES_PASSWORD "$postgres_password"
    environment_line COURTSIDE_DATABASE_URL "$answer_database_url"
    environment_line COURTSIDE_DATABASE_USERNAME "$answer_database_username"
    environment_line COURTSIDE_DATABASE_PASSWORD "$database_password"
    if [ "$answer_recipe" = full-self-hosted ]; then
      environment_line COURTSIDE_MAIL_HOSTNAME "mail.$answer_domain"
      environment_line COURTSIDE_MAIL_ADMIN_PASSWORD "$mail_admin"
      environment_line COURTSIDE_MAIL_SETUP_PASSWORD "$mail_setup"
      environment_line COURTSIDE_MAIL_RELOAD_PASSWORD "$mail_reload"
      environment_line COURTSIDE_MAIL_DKIM_SELECTOR courtside
    fi
    if contains_word "${answer_overlays//,/ }" custom-image; then
      environment_line COURTSIDE_CUSTOM_IMAGE_REPOSITORY "$answer_custom_image_repository"
      environment_line COURTSIDE_CUSTOM_IMAGE_DIGEST "$answer_custom_image_digest"
    fi
  } >> "$destination"
  chmod 600 "$destination"
}

command_reconfigure() {
  local answers_file="" confirmed=false old_recipe transaction
  while [ $# -gt 0 ]; do
    case "$1" in
      --answers) [ $# -ge 2 ] || refuse "--answers needs a file"; answers_file=$2; shift 2 ;;
      --yes) confirmed=true; shift ;;
      *) refuse "unknown reconfigure option $1" ;;
    esac
  done
  acquire_lock
  load_configuration
  old_recipe=$config_recipe
  answer_defaults
  if [ -n "$answers_file" ]; then read_answers "$answers_file"; else read_interactive_answers; fi
  validate_answers
  read_manifest "$installation_directory/current/manifest.json"
  validate_selection "$installation_directory/current"
  validate_reconfigure_secrets
  printf 'Plan: reconfigure recipe %s to %s in %s\n' "$old_recipe" "$answer_recipe" "$installation_directory"
  confirm "$confirmed"
  transaction=$(mktemp -d "$installation_directory/.transaction.partial.XXXXXX")
  temporary_path=$transaction
  chmod 700 "$transaction"
  write_reconfigured_environment "$transaction/.env"
  write_identity_secrets "$transaction/.env"
  write_installation_configuration "$transaction/installation.conf"
  mv "$transaction" "$installation_directory/.courtside-transaction"
  temporary_path=""
  apply_configuration_transaction
  printf 'Reconfigured recipe %s\n' "$answer_recipe"
}

recovery_path() {
  local requested=$1 parent base backup_root
  case "$requested" in
    /*) ;;
    *) requested="$PWD/$requested" ;;
  esac
  [ -d "$requested" ] && [ ! -L "$requested" ] || refuse "$requested is not a recovery directory"
  parent=${requested%/*}
  base=${requested##*/}
  parent=$(cd "$parent" && pwd -P)
  backup_root=$(cd "$installation_directory/backups" && pwd -P)
  [ "$parent" = "$backup_root" ] && [[ "$base" =~ ^recovery-[A-Za-z0-9.+-]+$ ]] \
    || refuse "recovery unit must be a direct child of $backup_root"
  selected_recovery="$parent/$base"
}

restore_probe() {
  local port=$1 cookie_jar=$2 username_file=$3 password_file=$4 after courts token
  local -a safe_curl
  [ -n "$curl_path" ] || { printf 'curl is required for the restored application probe\n' >&2; return 1; }
  safe_curl=("$env_path" -i "PATH=$PATH" "$curl_path" -q --noproxy '*')
  "${safe_curl[@]}" -fsS -c "$cookie_jar" "http://$port/api/session" >/dev/null \
    || { printf 'the restored application did not answer its session endpoint\n' >&2; return 1; }
  token=$(awk '$6 == "XSRF-TOKEN" { print $7 }' "$cookie_jar" | tail -n 1)
  [ -n "$token" ] || { printf 'the restored application issued no CSRF token\n' >&2; return 1; }
  "${safe_curl[@]}" -fsS -b "$cookie_jar" -c "$cookie_jar" -H "X-XSRF-TOKEN: $token" \
    --data-urlencode "username@$username_file" --data-urlencode "password@$password_file" \
    "http://$port/api/session" >/dev/null \
    || { printf 'the restored account could not sign in\n' >&2; return 1; }
  after=$("${safe_curl[@]}" -fsS -b "$cookie_jar" "http://$port/api/session") \
    || { printf 'the restored signed-in session could not be read\n' >&2; return 1; }
  [[ "$after" == *'"authenticated":true'* ]] \
    || { printf 'the restored account did not produce an authenticated session\n' >&2; return 1; }
  courts=$("${safe_curl[@]}" -fsS -b "$cookie_jar" "http://$port/api/public/courts") \
    || { printf 'the restored application could not read persisted courts\n' >&2; return 1; }
  [[ "$courts" == \[* ]] && [ "$courts" != "[]" ] \
    || { printf 'the restored application contains no persisted court data\n' >&2; return 1; }
}

command_restore_check() {
  local requested="" restore_project restore_environment restore_output port cookie_jar username_file password_file
  local restore_runtime table_count failure="" recovery_source_url recovery_config_recipe helper archive
  local trusted_recovery_release trusted_manifest_sha configured_manifest_sha recovery_overlays
  local recovery_custom_repository recovery_custom_digest expected_recovery_image expected_image_trust
  while [ $# -gt 0 ]; do
    case "$1" in
      --recovery) [ $# -ge 2 ] || refuse "--recovery needs a directory"; requested=$2; shift 2 ;;
      *) refuse "unknown restore-check option $1" ;;
    esac
  done
  [ -n "$requested" ] || refuse "restore-check requires --recovery"
  [ -n "${COURTSIDE_RESTORE_USERNAME:-}" ] && [ -n "${COURTSIDE_RESTORE_PASSWORD:-}" ] \
    || refuse "COURTSIDE_RESTORE_USERNAME and COURTSIDE_RESTORE_PASSWORD are required for the login probe"
  acquire_lock
  load_configuration
  recovery_path "$requested"
  verify_recovery_unit "$selected_recovery"
  trusted_recovery_release="$installation_directory/releases/$recovery_release"
  [ -d "$trusted_recovery_release" ] && [ ! -L "$trusted_recovery_release" ] \
    || refuse "the installed immutable release $recovery_release is required to check this recovery unit"
  verify_release "$trusted_recovery_release" \
    || refuse "the installed recovery release failed its integrity check"
  read_manifest "$trusted_recovery_release/manifest.json"
  [ "$recovery_release" = "$manifest_version" ] && [ "$recovery_revision" = "$manifest_revision" ] \
    || refuse "recovery metadata does not match the installed immutable release"
  trusted_manifest_sha=$(file_digest "$trusted_recovery_release/manifest.json")
  configured_manifest_sha=$(recovery_value \
    "$selected_recovery/configuration/installation.conf" release_manifest_sha256)
  [ "$configured_manifest_sha" = "$trusted_manifest_sha" ] \
    || refuse "recovery configuration does not bind the installed immutable release manifest"
  recovery_source_url=$(recovery_value "$selected_recovery/configuration/installation.conf" source_url)
  recovery_config_recipe=$(recovery_value "$selected_recovery/configuration/installation.conf" recipe)
  recovery_overlays=$(recovery_value "$selected_recovery/configuration/installation.conf" overlays)
  expected_recovery_image=$manifest_image
  expected_image_trust=official
  if contains_word "${recovery_overlays//,/ }" custom-image; then
    recovery_custom_repository=$(recovery_value \
      "$selected_recovery/configuration/installation.conf" custom_image_repository)
    recovery_custom_digest=$(recovery_value \
      "$selected_recovery/configuration/installation.conf" custom_image_digest)
    [[ "$recovery_custom_repository" =~ ^[A-Za-z0-9._:/-]+$ ]] \
      && [[ "$recovery_custom_digest" =~ ^[0-9a-f]{64}$ ]] \
      || refuse "recovery configuration has an invalid custom image identity"
    expected_recovery_image="$recovery_custom_repository@sha256:$recovery_custom_digest"
    expected_image_trust=custom
  fi
  [ "$recovery_image" = "$expected_recovery_image" ] \
    && [ "$recovery_image_trust" = "$expected_image_trust" ] \
    || refuse "recovery metadata does not match its effective application image"
  [[ "$recovery_source_url" =~ ^https?://[^/@:]+(:[0-9]+)?(/.*)?$ ]] \
    || refuse "recovery configuration has an invalid source URL"
  [ "$recovery_config_recipe" = "$recovery_recipe" ] \
    || refuse "recovery metadata does not match its installation recipe"
  prepare_docker_command
  if [ "$(recovery_value "$selected_recovery/recovery.conf" mail_state)" = captured ]; then
    helper=$(sed -n 's/^[[:space:]]*image: \(alpine:3@sha256:[0-9a-f]\{64\}\)$/\1/p' \
      "$trusted_recovery_release/compose.stalwart.yaml" | head -n 1)
    [[ "$helper" =~ ^alpine:3@sha256:[0-9a-f]{64}$ ]] \
      || refuse "the recovery release has no pinned mail archive reader"
    for archive in mail-config mail-data; do
      "${docker_command[@]}" run --rm --network none -i "$helper" tar -tf - \
        < "$selected_recovery/$archive.tar" >/dev/null \
        || refuse "$archive in the recovery unit is not a readable archive"
    done
  fi
  restore_project="$config_project-restore-check-$$"
  restore_output=$("${docker_command[@]}" compose ls --format json)
  [[ "$restore_output" != *'"Name":"'"$config_project"'-restore-check-'* ]] \
    || refuse "a stale restore-check project exists and requires operator inspection"
  if "${docker_command[@]}" volume inspect "${restore_project}_db" >/dev/null 2>&1; then
    refuse "restore target $restore_project already has a database volume"
  fi
  restore_runtime=$(mktemp -d "$installation_directory/.restore.partial.XXXXXX")
  temporary_path=$restore_runtime
  chmod 700 "$restore_runtime"
  restore_environment="$restore_runtime/environment"
  {
    environment_line COURTSIDE_RECOVERY_IMAGE_REPOSITORY "${recovery_image%@sha256:*}"
    environment_line COURTSIDE_RECOVERY_IMAGE_DIGEST "${recovery_image##*@sha256:}"
    environment_line COURTSIDE_RECOVERY_DATABASE_PASSWORD "$(random_secret)"
    environment_line COURTSIDE_RECOVERY_SOURCE_URL "$recovery_source_url"
  } > "$restore_environment"
  restore_compose=("${docker_command[@]}" compose --project-name "$restore_project" \
    --project-directory "$trusted_recovery_release" --env-file "$restore_environment" \
    -f "$trusted_recovery_release/compose.recovery-check.yaml")
  restore_output=$("${restore_compose[@]}" ps -a --format json)
  [ -z "$restore_output" ] || [ "$restore_output" = "[]" ] \
    || refuse "restore target $restore_project is not empty"
  password_file="$restore_runtime/password"
  printf '%s' "$COURTSIDE_RESTORE_PASSWORD" > "$password_file"
  chmod 600 "$password_file"
  username_file="$restore_runtime/username"
  printf '%s' "$COURTSIDE_RESTORE_USERNAME" > "$username_file"
  chmod 600 "$username_file"
  cookie_jar="$restore_runtime/cookies"
  : > "$cookie_jar"
  chmod 600 "$cookie_jar"
  restore_cleanup_active=true
  if ! "${restore_compose[@]}" up -d --wait db; then
    failure="PostgreSQL 17 did not become healthy"
  else
    table_count=$("${restore_compose[@]}" exec -T db psql -U courtside -d courtside -tAc \
      "select count(*) from pg_tables where schemaname = 'public'") || failure="the empty-target check failed"
    table_count=${table_count//[[:space:]]/}
    [ -n "$failure" ] || [ "$table_count" = 0 ] || failure="the PostgreSQL 17 restore target was not empty"
  fi
  if [ -z "$failure" ] && ! "${restore_compose[@]}" exec -T db pg_restore --clean --if-exists --no-owner \
    --single-transaction --exit-on-error -U courtside -d courtside < "$selected_recovery/database.dump"; then
    failure="the PostgreSQL dump could not be restored transactionally"
  fi
  if [ -z "$failure" ] && ! "${restore_compose[@]}" up -d --wait app; then
    failure="the restored application did not become healthy"
  fi
  if [ -z "$failure" ]; then
    port=$("${restore_compose[@]}" port app 8080)
    port=${port##*:}
    [[ "$port" =~ ^[0-9]+$ ]] || failure="restore-check could not resolve the application port"
  fi
  if [ -z "$failure" ] \
    && ! restore_probe "127.0.0.1:$port" "$cookie_jar" "$username_file" "$password_file"; then
    failure="the restored application failed its login or domain-data probe"
  fi
  if ! "${restore_compose[@]}" down --volumes --remove-orphans; then
    [ -n "$failure" ] || failure="the isolated restore target could not be removed"
  else
    restore_cleanup_active=false
  fi
  chmod -R u+w "$restore_runtime"
  rm -rf -- "$restore_runtime"
  temporary_path=""
  [ -z "$failure" ] || refuse "restore-check failed: $failure"
  printf 'Recovery unit %s restored into empty PostgreSQL 17 and passed login and domain-data probes\n' \
    "$selected_recovery"
}

prerelease_is_newer() {
  local candidate=$1 installed=$2 index candidate_identifier installed_identifier
  local candidate_identifiers installed_identifiers
  IFS='.' read -r -a candidate_identifiers <<< "$candidate"
  IFS='.' read -r -a installed_identifiers <<< "$installed"
  for ((index = 0; ; index++)); do
    candidate_identifier=${candidate_identifiers[$index]:-}
    installed_identifier=${installed_identifiers[$index]:-}
    [ -n "$candidate_identifier" ] || return 1
    [ -n "$installed_identifier" ] || return 0
    [ "$candidate_identifier" != "$installed_identifier" ] || continue
    if [[ "$candidate_identifier" =~ ^[0-9]+$ ]] && [[ "$installed_identifier" =~ ^[0-9]+$ ]]; then
      [ $((10#$candidate_identifier)) -gt $((10#$installed_identifier)) ]
      return $?
    fi
    [[ "$candidate_identifier" =~ ^[0-9]+$ ]] && return 1
    [[ "$installed_identifier" =~ ^[0-9]+$ ]] && return 0
    [[ "$candidate_identifier" > "$installed_identifier" ]]
    return $?
  done
}

version_is_newer() {
  local candidate=$1 installed=$2 candidate_core installed_core candidate_pre installed_pre index
  local candidate_parts installed_parts
  [[ "$candidate" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)(-([0-9A-Za-z.-]+))?$ ]] || return 1
  candidate_core="${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"
  candidate_pre=${BASH_REMATCH[5]:-}
  [[ "$installed" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)(-([0-9A-Za-z.-]+))?$ ]] || return 1
  installed_core="${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"
  installed_pre=${BASH_REMATCH[5]:-}
  read -r -a candidate_parts <<< "$candidate_core"
  read -r -a installed_parts <<< "$installed_core"
  for index in 0 1 2; do
    [ $((10#${candidate_parts[$index]})) -gt $((10#${installed_parts[$index]})) ] && return 0
    [ $((10#${candidate_parts[$index]})) -lt $((10#${installed_parts[$index]})) ] && return 1
  done
  [ -z "$candidate_pre" ] && [ -n "$installed_pre" ] && return 0
  [ -n "$candidate_pre" ] && [ -n "$installed_pre" ] \
    && prerelease_is_newer "$candidate_pre" "$installed_pre" && return 0
  return 1
}

write_updated_environment() {
  local destination=$1 digest=$2 line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      COURTSIDE_IMAGE_DIGEST=*) environment_line COURTSIDE_IMAGE_DIGEST "$digest" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$installation_directory/config/.env" > "$destination"
  chmod 600 "$destination"
}

command_update_check() {
  local archive=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --archive) [ $# -ge 2 ] || refuse "--archive needs a directory"; archive=$2; shift 2 ;;
      *) refuse "unknown update-check option $1" ;;
    esac
  done
  acquire_lock
  load_configuration
  if [ -z "$archive" ]; then
    printf 'installed_release=%s\nupdate=unknown\nreason=no-exact-release-archive\n' "$config_release"
    return 1
  fi
  [ -d "$archive" ] && [ ! -L "$archive" ] || refuse "$archive is not a release archive"
  read_manifest "$archive/manifest.json"
  verify_release "$archive" false || refuse "release archive integrity check failed"
  if version_is_newer "$manifest_version" "$config_release"; then
    printf 'installed_release=%s\ncandidate_release=%s\nupdate=available\n' "$config_release" "$manifest_version"
  else
    printf 'installed_release=%s\ncandidate_release=%s\nupdate=refused\n' "$config_release" "$manifest_version"
    return 1
  fi
}

command_update() {
  local archive="" confirmed=false installed_release target_release target_revision target_image target_digest
  local target_manifest_sha transaction old_compose
  while [ $# -gt 0 ]; do
    case "$1" in
      --archive) [ $# -ge 2 ] || refuse "--archive needs a directory"; archive=$2; shift 2 ;;
      --yes) confirmed=true; shift ;;
      *) refuse "unknown update option $1" ;;
    esac
  done
  [ -n "$archive" ] || refuse "update requires --archive with one exact release"
  [ -d "$archive" ] && [ ! -L "$archive" ] || refuse "$archive is not a release archive"
  acquire_lock
  load_configuration
  installed_release=$config_release
  read_manifest "$archive/manifest.json"
  if ! verify_release "$archive" false; then refuse "release archive integrity check failed"; fi
  version_is_newer "$manifest_version" "$installed_release" \
    || refuse "update requires a release newer than $installed_release; downgrade needs a complete recovery-unit restore"
  target_release=$manifest_version
  target_revision=$manifest_revision
  target_image=$manifest_image
  target_digest=$manifest_digest
  target_manifest_sha=$manifest_sha256
  [ -f "$archive/README.md" ] || refuse "release archive has no upgrade notes"
  printf 'Plan: update %s to exact release %s in %s\n' "$installed_release" "$target_release" "$installation_directory"
  printf 'Upgrade notes: %s/README.md\n' "$archive"
  confirm "$confirmed"
  create_backup 7
  manifest_version=$target_release
  manifest_revision=$target_revision
  manifest_image=$target_image
  manifest_digest=$target_digest
  manifest_sha256=$target_manifest_sha
  publish_release "$archive"
  if ! "${docker_command[@]}" image pull "$target_image"; then
    refuse "update pull failed; recovery unit $created_recovery is ready and database rollback was not attempted"
  fi
  compose_command
  old_compose=("${compose[@]}")
  if ! "${old_compose[@]}" stop app; then
    refuse "update could not stop the old application; recovery unit $created_recovery is ready and database rollback was not attempted"
  fi
  manifest_version=$target_release
  manifest_revision=$target_revision
  manifest_image=$target_image
  manifest_digest=$target_digest
  manifest_sha256=$target_manifest_sha
  transaction=$(mktemp -d "$installation_directory/.transaction.partial.XXXXXX")
  temporary_path=$transaction
  chmod 700 "$transaction"
  write_updated_environment "$transaction/.env" "$target_digest"
  write_installation_configuration "$transaction/installation.conf"
  printf '%s\n' "$target_release" > "$transaction/current-release"
  chmod 600 "$transaction/current-release"
  mv "$transaction" "$installation_directory/.courtside-transaction"
  temporary_path=""
  apply_configuration_transaction
  if ! compose_command || ! "${compose[@]}" up -d --wait; then
    refuse "release $target_release did not become healthy; recovery unit $created_recovery is ready and database rollback was not attempted"
  fi
  printf 'Updated from %s to %s after recovery unit %s\n' \
    "$installed_release" "$target_release" "$created_recovery"
}

analyse_adoption() {
  local project=$1 environment_file=$2 projects volumes exact_count related_count=0 name image matches
  local containers service running_image app_count=0 labels label_project label_volume
  [[ "$project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || refuse "invalid adoption project $project"
  [ -f "$environment_file" ] && [ ! -L "$environment_file" ] \
    || refuse "adoption environment must be a regular file"
  validate_environment_file "$environment_file"
  image=$(environment_value "$environment_file" COURTSIDE_IMAGE_DIGEST)
  [ "$image" = "$manifest_digest" ] || refuse "adoption environment does not select this release image"
  prepare_docker_command
  projects=$("${docker_command[@]}" compose ls --format json)
  matches=$(grep -o '"Name":"[^"]*"' <<< "$projects" || true)
  exact_count=$( (grep -o '"Name":"'"$project"'"' <<< "$matches" || true) | wc -l | tr -d ' ')
  while IFS= read -r name; do
    name=${name#'"Name":"'}
    name=${name%'"'}
    case "$name" in
      "$project" | "$project"-*) related_count=$((related_count + 1)) ;;
    esac
  done <<< "$matches"
  [ "$exact_count" -eq 1 ] && [ "$related_count" -eq 1 ] \
    || refuse "ambiguous ownership: expected exactly one Compose project named $project"
  containers=$("${docker_command[@]}" ps -a \
    --filter "label=com.docker.compose.project=$project" \
    --format '{{.Label "com.docker.compose.service"}}|{{.Image}}')
  while IFS='|' read -r service running_image; do
    [ -n "$service" ] || continue
    if [ "$service" = app ]; then
      app_count=$((app_count + 1))
      [ "$running_image" = "$manifest_image" ] \
        || refuse "ambiguous ownership: adopted app does not run the selected immutable image"
    fi
  done <<< "$containers"
  [ "$app_count" -eq 1 ] \
    || refuse "ambiguous ownership: expected exactly one app container for project $project"
  volumes=$("${docker_command[@]}" volume ls \
    --filter "label=com.docker.compose.project=$project" --format '{{.Name}}')
  [ -n "$volumes" ] \
    || refuse "ambiguous ownership: project $project has no labelled persistent volumes"
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    [[ "$name" == "$project"_* ]] \
      || refuse "ambiguous ownership: volume $name is not owned by project $project"
    labels=$("${docker_command[@]}" volume inspect "$name" \
      --format '{{ index .Labels "com.docker.compose.project" }}|{{ index .Labels "com.docker.compose.volume" }}')
    IFS='|' read -r label_project label_volume <<< "$labels"
    [ "$label_project" = "$project" ] && [ -n "$label_volume" ] \
      || refuse "ambiguous ownership: volume $name has inconsistent Compose labels"
  done <<< "$volumes"
  adoption_volumes=$volumes
}

validate_adoption_model() {
  local release_root=$1 environment_file=$2 project=$3 file expected_services running_services
  local expected_hashes running_hashes expected_volumes actual_volumes="" names name labels
  local label_project label_resource expected_networks actual_networks=""
  validate_selection "$release_root"
  adoption_compose=("${docker_command[@]}" compose --project-name "$project" \
    --project-directory "$release_root" --env-file "$environment_file")
  selection_arguments
  while IFS= read -r file; do
    adoption_compose+=(-f "$release_root/$file")
  done < <("$release_root/recipe.sh" files "${selection[@]}")
  "${adoption_compose[@]}" config --quiet >/dev/null \
    || refuse "the adopted environment does not render the selected recipe"
  expected_services=$("${adoption_compose[@]}" config --services | sort)
  running_services=$("${docker_command[@]}" ps -a \
    --filter "label=com.docker.compose.project=$project" \
    --format '{{.Label "com.docker.compose.service"}}' | sort)
  [ -n "$expected_services" ] && [ "$running_services" = "$expected_services" ] \
    || refuse "the adopted project service set does not match the selected recipe"
  expected_hashes=$("${adoption_compose[@]}" config --hash '*' | sort)
  running_hashes=$("${docker_command[@]}" ps -a \
    --filter "label=com.docker.compose.project=$project" \
    --format '{{.Label "com.docker.compose.service"}} {{.Label "com.docker.compose.config-hash"}}' | sort)
  [ -n "$expected_hashes" ] && [ "$running_hashes" = "$expected_hashes" ] \
    || refuse "the adopted project configuration hashes do not match the selected recipe"
  expected_volumes=$("${adoption_compose[@]}" config --volumes | sort)
  names=$("${docker_command[@]}" volume ls \
    --filter "label=com.docker.compose.project=$project" --format '{{.Name}}')
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    labels=$("${docker_command[@]}" volume inspect "$name" \
      --format '{{ index .Labels "com.docker.compose.project" }}|{{ index .Labels "com.docker.compose.volume" }}')
    IFS='|' read -r label_project label_resource <<< "$labels"
    [ "$label_project" = "$project" ] && [ -n "$label_resource" ] \
      || refuse "the adopted project has inconsistent volume ownership"
    actual_volumes+="$label_resource"$'\n'
  done <<< "$names"
  actual_volumes=$(printf '%s' "$actual_volumes" | sort)
  [ -n "$expected_volumes" ] && [ "$actual_volumes" = "$expected_volumes" ] \
    || refuse "the adopted project volume set does not match the selected recipe"
  expected_networks=$("${adoption_compose[@]}" config --networks | sort)
  names=$("${docker_command[@]}" network ls \
    --filter "label=com.docker.compose.project=$project" --format '{{.Name}}')
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    labels=$("${docker_command[@]}" network inspect "$name" \
      --format '{{ index .Labels "com.docker.compose.project" }}|{{ index .Labels "com.docker.compose.network" }}')
    IFS='|' read -r label_project label_resource <<< "$labels"
    [ "$label_project" = "$project" ] && [ -n "$label_resource" ] \
      || refuse "the adopted project has inconsistent network ownership"
    actual_networks+="$label_resource"$'\n'
  done <<< "$names"
  actual_networks=$(printf '%s' "$actual_networks" | sort)
  [ -n "$expected_networks" ] && [ "$actual_networks" = "$expected_networks" ] \
    || refuse "the adopted project network set does not match the selected recipe"
}

command_adopt() {
  local mode="" project="" environment_file="" answers_file="" confirmed=false
  local adoption_environment config_staging adopted_database_material
  while [ $# -gt 0 ]; do
    case "$1" in
      --analyze) [ -z "$mode" ] || refuse "choose one adoption mode"; mode=analyze; shift ;;
      --apply) [ -z "$mode" ] || refuse "choose one adoption mode"; mode=apply; shift ;;
      --project) [ $# -ge 2 ] || refuse "--project needs a name"; project=$2; shift 2 ;;
      --environment) [ $# -ge 2 ] || refuse "--environment needs a file"; environment_file=$2; shift 2 ;;
      --answers) [ $# -ge 2 ] || refuse "--answers needs a file"; answers_file=$2; shift 2 ;;
      --yes) confirmed=true; shift ;;
      *) refuse "unknown adopt option $1" ;;
    esac
  done
  [ -n "$mode" ] && [ -n "$project" ] && [ -n "$environment_file" ] \
    || refuse "adopt requires a mode, --project and --environment"
  read_manifest "$script_directory/manifest.json"
  verify_release "$script_directory" false || refuse "release archive integrity check failed"
  analyse_adoption "$project" "$environment_file"
  printf 'analysis=adoptable\nproject=%s\nrelease=%s\n' "$project" "$manifest_version"
  while IFS= read -r volume; do [ -z "$volume" ] || printf 'volume=%s\n' "$volume"; done <<< "$adoption_volumes"
  [ "$mode" = apply ] || return 0
  [ -n "$answers_file" ] || refuse "adopt --apply requires --answers"
  answer_defaults
  read_answers "$answers_file"
  validate_answers
  [ "$answer_project" = "$project" ] || refuse "adoption answers name another Compose project"
  adoption_environment=$(mktemp "$installation_directory.adoption-environment.XXXXXX")
  temporary_path=$adoption_environment
  cp "$environment_file" "$adoption_environment"
  chmod 600 "$adoption_environment"
  if [ "$answer_recipe" != existing-infrastructure ]; then
    adopted_database_material=$(environment_value "$adoption_environment" POSTGRES_PASSWORD)
    [[ "$adopted_database_material" =~ ^[0-9a-f]{48}$ ]] \
      || refuse "bundled PostgreSQL adoption requires a generated 48-character hexadecimal password"
  fi
  validate_adoption_model "$script_directory" "$adoption_environment" "$project"
  printf 'Plan: adopt project %s into %s without recreating its resources\n' "$project" "$installation_directory"
  confirm "$confirmed"
  analyse_adoption "$project" "$adoption_environment"
  validate_adoption_model "$script_directory" "$adoption_environment" "$project"
  acquire_lock
  [ ! -e "$installation_directory/config" ] || refuse "installation state already exists"
  publish_release
  mkdir -p "$installation_directory/secrets" "$installation_directory/backups"
  chmod 700 "$installation_directory/secrets" "$installation_directory/backups"
  config_staging=$(mktemp -d "$installation_directory/.config.partial.XXXXXX")
  cp "$adoption_environment" "$config_staging/.env"
  rm -f -- "$adoption_environment"
  temporary_path=$config_staging
  chmod 700 "$config_staging"
  chmod 600 "$config_staging/.env"
  write_installation_configuration "$config_staging/installation.conf"
  mv "$config_staging" "$installation_directory/config"
  temporary_path=""
  publish_current
  printf 'Adopted project %s without changing its containers or volumes\n' "$project"
}

replace_environment_secret() {
  local source=$1 destination=$2 wanted=$3 replacement=$4 line key found=false
  while IFS= read -r line || [ -n "$line" ]; do
    key=${line%%=*}
    if [ "$key" = "$wanted" ]; then
      environment_line "$wanted" "$replacement"
      found=true
    else
      printf '%s\n' "$line"
    fi
  done < "$source" > "$destination"
  [ "$found" = true ] || refuse "the selected secret is not configured for this installation"
  chmod 600 "$destination"
}

publish_environment_file() {
  local source=$1 transaction
  transaction=$(mktemp -d "$installation_directory/.transaction.partial.XXXXXX")
  temporary_path=$transaction
  chmod 700 "$transaction"
  cp "$source" "$transaction/.env"
  chmod 600 "$transaction/.env"
  mv "$transaction" "$installation_directory/.courtside-transaction"
  temporary_path=""
  apply_configuration_transaction
}

retire_rotation_journal() {
  local journal=$1 tombstone="$installation_directory/.rotation.complete.$$"
  mv "$journal" "$tombstone"
  rm -f -- "$tombstone"/*
  rmdir -- "$tombstone"
}

recover_secret_rotation() {
  local requested=$1 journal="$installation_directory/.courtside-rotation"
  local saved_name kind role component old_value
  [ -e "$journal" ] || return 0
  [ -d "$journal" ] && [ ! -L "$journal" ] || refuse "$journal is not a safe rotation journal"
  [ "$(path_mode "$journal")" = 700 ] && [ "$(path_owner "$journal")" = "$(id -u)" ] \
    || refuse "$journal must be owned by the operator with mode 0700"
  for component in "$journal"/*; do
    [ -f "$component" ] && [ ! -L "$component" ] \
      || refuse "$journal contains an unsafe entry"
    [ "$(path_mode "$component")" = 600 ] && [ "$(path_owner "$component")" = "$(id -u)" ] \
      || refuse "$component must be owned by the operator with mode 0600"
    case "${component##*/}" in meta | old.env | new.env | old.secret | new.secret) ;;
      *) refuse "$journal contains an unknown entry" ;;
    esac
  done
  saved_name=$(recovery_value "$journal/meta" name)
  kind=$(recovery_value "$journal/meta" kind)
  [ "$saved_name" = "$requested" ] \
    || refuse "interrupted $saved_name rotation must be recovered before rotating $requested"
  case "$kind:$saved_name" in
    env:mail-relay)
      publish_environment_file "$journal/new.env"
      compose_command
      "${compose[@]}" up -d --wait app \
        || refuse "interrupted mail-relay rotation still requires provider reconciliation"
      ;;
    env:*)
      publish_environment_file "$journal/old.env"
      compose_command
      if [[ "$saved_name" == mail-* ]]; then
        "${compose[@]}" --profile mail-setup run --rm mail-configure \
          || refuse "interrupted $saved_name rotation could not restore Stalwart"
        component=mail
        [ "$saved_name" != mail-reload ] || component=mail-reload
      elif [ "$saved_name" = postgres ]; then
        old_value=$(environment_value "$journal/old.env" POSTGRES_PASSWORD)
        printf "ALTER ROLE courtside PASSWORD '%s';\n" "$old_value" \
          | "${compose[@]}" exec -T db psql -v ON_ERROR_STOP=1 -U courtside -d courtside \
          || refuse "interrupted postgres rotation could not restore the database credential"
        component=app
      else
        refuse "rotation journal names an unknown environment secret"
      fi
      "${compose[@]}" up -d --wait "$component" \
        || refuse "interrupted $saved_name rotation could not restore service health"
      ;;
    file:database-owner) role=courtside_owner; component="database-setup" ;;
    file:database-migration) role=courtside_migration; component="database-migrate" ;;
    file:database-runtime) role=courtside_runtime; component=app ;;
    *) refuse "rotation journal has an unsupported identity" ;;
  esac
  if [ "$kind" = file ]; then
    old_value=$(< "$journal/old.secret")
    compose_command
    printf "ALTER ROLE %s PASSWORD '%s';\n" "$role" "$old_value" \
      | "${compose[@]}" exec -T db psql -v ON_ERROR_STOP=1 -U courtside_owner -d courtside \
      || refuse "interrupted $saved_name rotation could not restore its database role"
    cp "$journal/old.secret" "$installation_directory/secrets/$saved_name-password"
    chmod 600 "$installation_directory/secrets/$saved_name-password"
    "${compose[@]}" up -d --wait "$component" \
      || refuse "interrupted $saved_name rotation could not restore service health"
  fi
  retire_rotation_journal "$journal"
  printf 'Recovered interrupted %s rotation before continuing\n' "$saved_name"
}

command_rotate_secret() {
  local name=${1:-} confirmed=false key="" component transaction replacement rollback journal staging
  local file_identity=false role="" material_path pending previous_value
  [ -n "$name" ] || refuse "rotate-secret requires a secret name"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) confirmed=true; shift ;;
      *) refuse "unknown rotate-secret option $1" ;;
    esac
  done
  case "$name" in
    postgres) key=POSTGRES_PASSWORD; component=app ;;
    mail-admin) key=COURTSIDE_MAIL_ADMIN_PASSWORD; component=mail ;;
    mail-setup) key=COURTSIDE_MAIL_SETUP_PASSWORD; component=mail ;;
    mail-reload) key=COURTSIDE_MAIL_RELOAD_PASSWORD; component=mail-reload ;;
    mail-relay) key=COURTSIDE_MAIL_PASSWORD; component=app ;;
    database-owner) file_identity=true; role=courtside_owner; component="database-setup" ;;
    database-migration) file_identity=true; role=courtside_migration; component="database-migrate" ;;
    database-runtime) file_identity=true; role=courtside_runtime; component=app ;;
    *) refuse "unknown rotatable secret $name" ;;
  esac
  acquire_lock
  load_configuration
  case "$name:$config_recipe" in
    postgres:existing-infrastructure) refuse "postgres rotation is available only for the bundled database" ;;
    mail-admin:full-self-hosted | mail-setup:full-self-hosted | mail-reload:full-self-hosted) ;;
    mail-*:*) [ "$name" = mail-relay ] || refuse "$name is available only for full-self-hosted" ;;
  esac
  if [ "$file_identity" = true ]; then
    [ "$config_recipe" != existing-infrastructure ] \
      || refuse "database identity rotation for an external database remains operator-owned"
    contains_word "${config_overlays//,/ }" database-identities \
      || refuse "$name requires the database-identities overlay"
  fi
  recover_secret_rotation "$name"
  printf 'Plan: rotate only %s and restart %s\n' "$name" "$component"
  confirm "$confirmed"
  if [ "$name" = mail-relay ]; then
    replacement=${COURTSIDE_NEW_SECRET:-}
    [ -n "$replacement" ] || refuse "mail-relay rotation requires COURTSIDE_NEW_SECRET after the relay changed"
  else
    replacement=$(random_secret)
  fi
  if [ "$file_identity" = true ]; then
    material_path="$installation_directory/secrets/$name-password"
    [ -f "$material_path" ] && [ ! -L "$material_path" ] || refuse "$material_path is not a safe secret file"
    previous_value=$(< "$material_path")
    [[ "$previous_value" =~ ^[0-9a-f]{48}$ ]] || refuse "$material_path has an unexpected value"
    pending=$(mktemp "$installation_directory/secrets/.$name.partial.XXXXXX")
    printf '%s\n' "$replacement" > "$pending"
    chmod 600 "$pending"
    staging=$(mktemp -d "$installation_directory/.rotation.partial.XXXXXX")
    chmod 700 "$staging"
    printf 'name=%s\nkind=file\n' "$name" > "$staging/meta"
    cp "$material_path" "$staging/old.secret"
    cp "$pending" "$staging/new.secret"
    chmod 600 "$staging"/*
    journal="$installation_directory/.courtside-rotation"
    mv "$staging" "$journal"
    compose_command
    if ! printf "ALTER ROLE %s PASSWORD '%s';\n" "$role" "$replacement" \
      | "${compose[@]}" exec -T db psql -v ON_ERROR_STOP=1 -U courtside_owner -d courtside; then
      rm -f -- "$pending"
      retire_rotation_journal "$journal"
      refuse "$name rotation failed before local state changed"
    fi
    mv "$pending" "$material_path"
    if ! "${compose[@]}" up -d --wait "$component"; then
      printf "ALTER ROLE %s PASSWORD '%s';\n" "$role" "$previous_value" \
        | "${compose[@]}" exec -T db psql -v ON_ERROR_STOP=1 -U courtside_owner -d courtside >/dev/null 2>&1 \
        || refuse "$name rotation failed and its database rollback also failed"
      printf '%s\n' "$previous_value" > "$material_path"
      chmod 600 "$material_path"
      retire_rotation_journal "$journal"
      refuse "$name rotation did not become healthy; the previous identity was restored"
    fi
    retire_rotation_journal "$journal"
    printf 'Rotated %s without changing another stored identity\n' "$name"
    return 0
  fi
  staging=$(mktemp -d "$installation_directory/.rotation.partial.XXXXXX")
  temporary_path=$staging
  chmod 700 "$staging"
  printf 'name=%s\nkind=env\n' "$name" > "$staging/meta"
  cp "$installation_directory/config/.env" "$staging/old.env"
  replace_environment_secret "$staging/old.env" "$staging/new.env" "$key" "$replacement"
  chmod 600 "$staging"/*
  journal="$installation_directory/.courtside-rotation"
  mv "$staging" "$journal"
  temporary_path=""
  rollback="$journal/old.env"
  publish_environment_file "$journal/new.env"
  compose_command
  if [[ "$name" == mail-* ]] && [ "$name" != mail-relay ]; then
    if ! "${compose[@]}" --profile mail-setup run --rm mail-configure; then
      publish_environment_file "$rollback"
      compose_command
      if ! "${compose[@]}" --profile mail-setup run --rm mail-configure >/dev/null 2>&1; then
        refuse "$name rotation failed and Stalwart also refused the previous configuration"
      fi
      retire_rotation_journal "$journal"
      refuse "$name rotation was refused by Stalwart; the previous local value was restored"
    fi
  elif [ "$name" = postgres ]; then
    if ! printf "ALTER ROLE courtside PASSWORD '%s';\n" "$replacement" \
      | "${compose[@]}" exec -T db psql -v ON_ERROR_STOP=1 -U courtside -d courtside; then
      publish_environment_file "$rollback"
      retire_rotation_journal "$journal"
      refuse "database secret rotation failed; the previous local value was restored"
    fi
  fi
  if ! "${compose[@]}" up -d --wait "$component"; then
    if [ "$name" = mail-relay ]; then
      refuse "mail-relay did not become healthy; the new local value was retained because provider rollback is operator-owned"
    fi
    publish_environment_file "$rollback"
    compose_command
    if [[ "$name" == mail-* ]] && [ "$name" != mail-relay ]; then
      if ! "${compose[@]}" --profile mail-setup run --rm mail-configure >/dev/null 2>&1; then
        refuse "$name restart failed and Stalwart also refused the previous configuration"
      fi
    elif [ "$name" = postgres ]; then
      printf "ALTER ROLE courtside PASSWORD '%s';\n" \
        "$(environment_value "$rollback" POSTGRES_PASSWORD)" \
        | "${compose[@]}" exec -T db psql -v ON_ERROR_STOP=1 -U courtside -d courtside >/dev/null 2>&1 \
        || true
    fi
    "${compose[@]}" up -d --wait "$component" >/dev/null 2>&1 || true
    retire_rotation_journal "$journal"
    refuse "$name rotation did not become healthy; the previous local value was restored"
  fi
  retire_rotation_journal "$journal"
  printf 'Rotated %s without changing another stored identity\n' "$name"
}

json_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\b'/\\b}
  value=${value//$'\f'/\\f}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

doctor_result() {
  local state=$1 name=$2 detail=$3
  doctor_checks+=("{\"state\":\"$state\",\"name\":\"$name\",\"detail\":\"$(json_escape "$detail")\"}")
  case "$state" in
    WARN) doctor_warnings=$((doctor_warnings + 1)) ;;
    FAIL) doctor_failures=$((doctor_failures + 1)) ;;
  esac
}

emit_doctor() {
  local format=$1 result=PASS separator="" check
  [ "$doctor_warnings" -eq 0 ] || result=WARN
  [ "$doctor_failures" -eq 0 ] || result=FAIL
  if [ "$format" = json ]; then
    printf '{"schema":1,"result":"%s","checks":[' "$result"
    for check in "${doctor_checks[@]}"; do
      printf '%s%s' "$separator" "$check"
      separator=,
    done
    printf ']}\n'
  else
    for check in "${doctor_checks[@]}"; do
      printf '%s\n' "$check"
    done
    printf 'RESULT %s\n' "$result"
  fi
  [ "$doctor_failures" -eq 0 ] || return 2
  [ "$doctor_warnings" -eq 0 ] || return 1
}

path_mode() {
  stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null || true
}

path_owner() {
  stat -c %u "$1" 2>/dev/null || stat -f %u "$1" 2>/dev/null || true
}

command_doctor() {
  local format=text parsed="" mode path problem private_permissions=true secret_permissions=true
  local operator state port response
  operator=$(id -u)
  [ $# -eq 0 ] || { [ "$1" = --json ] && [ $# -eq 1 ] || refuse "doctor accepts only --json"; format=json; }
  doctor_checks=()
  doctor_warnings=0
  doctor_failures=0
  if [ ! -f "$installation_directory/config/installation.conf" ]; then
    doctor_result FAIL installation "installation.conf is missing"
    emit_doctor "$format"
    return $?
  fi
  if ! parsed=$( (load_configuration) 2>&1); then
    doctor_result FAIL configuration "$parsed"
    emit_doctor "$format"
    return $?
  fi
  acquire_lock
  load_configuration
  doctor_result PASS configuration "schema $config_schema, release $config_release, recipe $config_recipe"
  if [ -L "$installation_directory/current" ] \
    && [ "$(readlink "$installation_directory/current")" = "releases/$config_release" ] \
    && [ -f "$installation_directory/current/manifest.json" ]; then
    read_manifest "$installation_directory/current/manifest.json"
    if [ "$manifest_revision" = "$config_revision" ] && [ "$manifest_image" = "$config_image" ] \
      && [ "$manifest_sha256" = "$config_release_manifest_sha256" ]; then
      if problem=$(verify_release "$installation_directory/releases/$config_release" 2>&1); then
        doctor_result PASS release "current matches the configured revision, image and file inventory"
      else
        doctor_result FAIL release "$problem"
      fi
    else
      doctor_result FAIL release "current does not match installation.conf"
    fi
  else
    doctor_result FAIL release "current is not a release link"
  fi
  mode=$(path_mode "$installation_directory/config/.env")
  if [ "$mode" = 600 ]; then
    doctor_result PASS permissions ".env is mode 0600"
  else
    doctor_result FAIL permissions ".env must be mode 0600"
  fi
  for path in "$installation_directory" "$installation_directory/config" \
    "$installation_directory/secrets" "$installation_directory/backups" \
    "$installation_directory/releases"; do
    [ "$(path_mode "$path")" = 700 ] && [ "$(path_owner "$path")" = "$operator" ] \
      || private_permissions=false
  done
  if [ "$private_permissions" = true ]; then
    doctor_result PASS private-directories "installation state directories are mode 0700"
  else
    doctor_result FAIL private-directories "installation state directories must be mode 0700"
  fi
  for path in "$installation_directory"/secrets/*; do
    [ -e "$path" ] || continue
    if [ -L "$path" ] || [ ! -f "$path" ] || [ "$(path_mode "$path")" != 600 ] \
      || [ "$(path_owner "$path")" != "$operator" ]; then
      secret_permissions=false
    fi
  done
  if [ "$secret_permissions" = true ]; then
    doctor_result PASS secret-files "secret files are regular files with mode 0600"
  else
    doctor_result FAIL secret-files "secret files must be regular mode-0600 files"
  fi
  if [ -n "$docker_path" ]; then
    prepare_docker_command
  fi
  if [ -n "$docker_path" ] && "${docker_command[@]}" compose version >/dev/null 2>&1; then
    doctor_result PASS compose "Docker Compose is available"
    if (compose_command && "${compose[@]}" config --quiet >/dev/null 2>&1); then
      doctor_result PASS model "the selected Compose model renders"
    else
      doctor_result FAIL model "the selected Compose model does not render"
    fi
    if [ "$config_recipe" = funnel ] || [ "$config_recipe" = existing-infrastructure ]; then
      state=$(docker_components 2>/dev/null || true)
      if grep -Eq '^proxy=(running|healthy)$' <<< "$state"; then
        port=$(environment_value "$installation_directory/config/.env" COURTSIDE_PORT)
        port=${port:-8080}
        response=""
        if [ -n "$curl_path" ]; then
          response=$("$env_path" -i "PATH=$PATH" "$curl_path" -q --noproxy '*' \
            --fail --silent --show-error --max-time 5 --header "Host: $config_domain" \
            --header 'X-Forwarded-Proto: https' "http://127.0.0.1:$port/api/session" 2>/dev/null || true)
        fi
        if [[ "$response" == *'"authenticated":'* ]]; then
          doctor_result PASS local-listener "the forwarded Caddy listener answers HTTP on 127.0.0.1:$port"
        else
          doctor_result FAIL local-listener "the forwarded Caddy listener does not answer HTTP on 127.0.0.1:$port"
        fi
      else
        doctor_result FAIL local-listener "the proxy is not running, so the forwarded Caddy listener is unavailable"
      fi
    else
      doctor_result PASS local-listener "the selected recipe has no forwarded loopback listener"
    fi
  else
    doctor_result FAIL compose "Docker with Compose is unavailable"
  fi
  if [ -f "$installation_directory/config/local.override.yaml" ]; then
    doctor_result WARN local-override "config/local.override.yaml is applied but its keys are operator-owned"
    mode=$(path_mode "$installation_directory/config/local.override.yaml")
    if [ -L "$installation_directory/config/local.override.yaml" ] \
      || [ $((8#$mode & 0022)) -ne 0 ] \
      || [ "$(path_owner "$installation_directory/config/local.override.yaml")" != "$operator" ]; then
      doctor_result FAIL override-permissions "config/local.override.yaml must be operator-owned and not group- or world-writable"
    fi
  fi
  emit_doctor "$format"
}

docker_ps() {
  compose_command
  "${compose[@]}" ps --format json
}

docker_components() {
  compose_command
  "${compose[@]}" ps --format '{{.Service}}={{if .Health}}{{.Health}}{{else}}{{.State}}{{end}}'
}

latest_backup_age() {
  local file newest=0 created created_epoch now index selected_index selected_epoch
  local -a candidate_epochs=() candidate_paths=()
  now=$(date +%s)
  for file in "$installation_directory"/backups/recovery-*; do
    [ -d "$file" ] && [ ! -L "$file" ] || continue
    [ -f "$file/recovery.conf" ] && [ ! -L "$file/recovery.conf" ] || continue
    created=$(recovery_value "$file/recovery.conf" created_at)
    created_epoch=$(recovery_timestamp_epoch "$created") || continue
    [ "$created_epoch" -le "$now" ] || continue
    candidate_epochs+=("$created_epoch")
    candidate_paths+=("$file")
  done
  while [ "${#candidate_epochs[@]}" -gt 0 ]; do
    selected_index=""
    selected_epoch=0
    for index in "${!candidate_epochs[@]}"; do
      if [ "${candidate_epochs[$index]}" -gt "$selected_epoch" ]; then
        selected_index=$index
        selected_epoch=${candidate_epochs[$index]}
      fi
    done
    file=${candidate_paths[$selected_index]}
    if (trap - EXIT; verify_recovery_unit "$file") >/dev/null 2>&1; then
      newest=$selected_epoch
      break
    fi
    unset 'candidate_epochs[selected_index]' 'candidate_paths[selected_index]'
  done
  [ "$newest" -gt 0 ] || { printf 'unknown'; return; }
  printf '%s' "$((now - newest))"
}

command_up() {
  [ $# -eq 0 ] || refuse "up accepts no options"
  acquire_lock
  compose_command
  "${compose[@]}" up -d
}

command_mail_check() {
  local components
  [ $# -eq 0 ] || refuse "mail-check accepts no options"
  acquire_lock
  compose_command
  if [ "$config_recipe" = full-self-hosted ]; then
    "${compose[@]}" --profile mail-check run --rm mail-check
    return 0
  fi
  if [ "$config_synthetic_mail" = true ]; then
    components=$("${compose[@]}" ps --format '{{.Service}}={{if .Health}}{{.Health}}{{else}}{{.State}}{{end}}' \
      2>/dev/null || true)
    if grep -qx 'mailpit=healthy' <<< "$components"; then
      printf 'mail_check=pass\nreason=synthetic-mailpit-running\n'
      return 0
    fi
    printf 'mail_check=fail\nreason=synthetic-mailpit-unavailable\n'
    return 2
  fi
  printf 'mail_check=unknown\nreason=external-relay-is-operator-owned\n'
  return 1
}

command_status() {
  local state components infrastructure=unknown bootstrap=pending club_setup=unknown migration=application-startup
  [ $# -eq 0 ] || refuse "status accepts no options"
  acquire_lock
  load_configuration
  state=$(docker_ps)
  components=$(docker_components | tr '\n' ',' || true)
  if [[ "$state" == *'"Health":"healthy"'* ]] && [[ "$state" != *'"State":"exited"'* ]] \
    && [[ "$state" != *'"Health":"unhealthy"'* ]]; then
    infrastructure=healthy
  fi
  grep -q '^COURTSIDE_BOOTSTRAP_ADMIN_PASSWORD=' "$installation_directory/config/.env" || bootstrap=finalized
  contains_word "${config_overlays//,/ }" database-identities && migration=one-shot
  printf 'release=%s\nrevision=%s\nimage=%s\nrecipe=%s\n' \
    "$config_release" "$config_revision" "$config_image" "$config_recipe"
  printf 'infrastructure=%s\nbootstrap=%s\nclub_setup=%s\nmigration=%s\n' \
    "$infrastructure" "$bootstrap" "$club_setup" "$migration"
  printf 'component_health=%s\n' "${components%,}"
  if [ "$config_synthetic_mail" = true ] && [[ ",$components" == *',mailpit=healthy,'* ]]; then
    printf 'mail_handover=synthetic\n'
  elif [ "$config_synthetic_mail" = true ]; then
    printf 'mail_handover=unavailable\n'
  elif [[ "$state" == *'"Service":"mail"'* ]]; then
    printf 'mail_handover=running\n'
  elif [ "$config_recipe" = full-self-hosted ]; then
    printf 'mail_handover=unavailable\n'
  else
    printf 'mail_handover=external\n'
  fi
  printf 'backup_age_seconds=%s\n' "$(latest_backup_age)"
  printf 'free_storage_kib=%s\n' "$(df -Pk "$installation_directory" | awk 'NR == 2 { print $4 }')"
  [ -f "$installation_directory/config/local.override.yaml" ] \
    && printf 'local_override=present support=operator-owned keys=unknown\nwarnings=local-override-keys-unknown\n' \
    || printf 'local_override=absent\nwarnings=none\n'
}

command_finalize_bootstrap() {
  local confirmed=false line transaction path latest=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) confirmed=true; shift ;;
      *) refuse "unknown finalize-bootstrap option $1" ;;
    esac
  done
  [ "$confirmed" = true ] || refuse "finalize-bootstrap requires --yes after the password was replaced"
  acquire_lock
  load_configuration
  while IFS= read -r path; do latest=$path; done \
    < <(printf '%s\n' "$installation_directory"/backups/recovery-* | sort)
  [ -n "$latest" ] && [ "$latest" != "$installation_directory/backups/recovery-*" ] \
    || refuse "finalize-bootstrap requires a verified backup of the current release"
  verify_recovery_unit "$latest"
  [ "$recovery_release" = "$config_release" ] && [ "$recovery_revision" = "$config_revision" ] \
    || refuse "finalize-bootstrap requires a verified backup of the current release"
  transaction=$(mktemp -d "$installation_directory/.transaction.partial.XXXXXX")
  temporary_path=$transaction
  chmod 700 "$transaction"
  umask 077
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      COURTSIDE_BOOTSTRAP_ADMIN_*=*) ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$installation_directory/config/.env" > "$transaction/.env"
  chmod 600 "$transaction/.env"
  : > "$transaction/remove-bootstrap"
  chmod 600 "$transaction/remove-bootstrap"
  mv "$transaction" "$installation_directory/.courtside-transaction"
  temporary_path=""
  apply_configuration_transaction
  printf 'Bootstrap values and the bootstrap credential file removed after operator confirmation\n'
}

command_diagnose() {
  local state infrastructure=unknown
  [ $# -eq 0 ] || refuse "diagnose accepts no options"
  acquire_lock
  load_configuration
  state=$(docker_ps 2>/dev/null || true)
  [[ "$state" == *'"Health":"healthy"'* ]] && infrastructure=healthy
  printf 'schema=1\nrelease=%s\nrevision=%s\nimage=%s\nrecipe=%s\ninfrastructure=%s\n' \
    "$config_release" "$config_revision" "$config_image" "$config_recipe" "$infrastructure"
  [ -f "$installation_directory/config/local.override.yaml" ] \
    && printf 'local_override=present support=operator-owned\n' \
    || printf 'local_override=absent\n'
  printf 'backup_age_seconds=%s\n' "$(latest_backup_age)"
}

command_uninstall() {
  local keep_data=false destroy=false confirmed=false confirmation="" expected volumes entry parent
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep-data) keep_data=true; shift ;;
      --destroy) destroy=true; shift ;;
      --yes) confirmed=true; shift ;;
      --confirm) [ $# -ge 2 ] || refuse "--confirm needs the exact phrase"; confirmation=$2; shift 2 ;;
      *) refuse "unknown uninstall option $1" ;;
    esac
  done
  [ "$keep_data" != "$destroy" ] || refuse "choose either uninstall --keep-data or --destroy"
  if [ "$destroy" = true ]; then
    case "$installation_directory" in
      / | /usr | /var | /srv | /opt | /home | /Users) refuse "installation path is too broad to remove" ;;
    esac
  fi
  acquire_lock
  compose_command
  if [ "$keep_data" = true ]; then
    [ "$confirmed" = true ] || refuse "uninstall --keep-data requires --yes"
    "${compose[@]}" down
    printf 'Containers removed; volumes and %s were kept\n' "$installation_directory"
    return 0
  fi
  expected="delete $config_project at $installation_directory"
  volumes=$("${docker_command[@]}" volume ls \
    --filter "label=com.docker.compose.project=$config_project" --format '{{.Name}}')
  printf 'Plan: remove project %s, installation path %s and these project volumes:\n' \
    "$config_project" "$installation_directory"
  printf '%s\n' "$volumes"
  [ "$confirmation" = "$expected" ] || refuse "destructive removal requires --confirm '$expected'"
  while IFS= read -r -d '' entry; do
    case "${entry##*/}" in
      .courtside-installation | .courtside.lock | releases | config | secrets | backups | current) ;;
      *) refuse "destructive removal found an unowned installation entry: ${entry##*/}" ;;
    esac
  done < <(find "$installation_directory" -mindepth 1 -maxdepth 1 -print0)
  "${compose[@]}" down --volumes --remove-orphans
  owns_lock=false
  for entry in .courtside-installation .courtside.lock releases config secrets backups current; do
    if [ -e "$installation_directory/$entry" ] || [ -L "$installation_directory/$entry" ]; then
      if [ ! -L "$installation_directory/$entry" ]; then
        chmod -R u+w "$installation_directory/$entry"
      fi
      rm -rf -- "$installation_directory/$entry"
    fi
  done
  if [ -n "$(find "$installation_directory" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    refuse "destructive removal stopped because an unowned installation entry appeared"
  fi
  if rmdir -- "$installation_directory" 2>/dev/null; then
    printf 'Removed project %s and installation path %s\n' "$config_project" "$installation_directory"
  else
    parent=${installation_directory%/*}
    if [ ! -w "$parent" ]; then
      printf 'Removed project %s and emptied installation path %s\n' "$config_project" "$installation_directory"
      printf 'Run: sudo rmdir -- %q\n' "$installation_directory"
    else
      refuse "destructive removal could not remove the empty installation path $installation_directory"
    fi
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --directory)
      [ $# -ge 2 ] || refuse "--directory needs a path"
      absolute_installation_directory "$2"
      shift 2
      ;;
    --*) refuse "unknown global option $1" ;;
    *) break ;;
  esac
done

[ -n "$installation_directory" ] || infer_installation_directory
[ $# -ge 1 ] || refuse "$usage"
command=$1
shift
case "$command" in
  init) command_init "$@" ;;
  reconfigure) command_reconfigure "$@" ;;
  backup) command_backup "$@" ;;
  restore-check) command_restore_check "$@" ;;
  update) command_update "$@" ;;
  update-check) command_update_check "$@" ;;
  adopt) command_adopt "$@" ;;
  rotate-secret) command_rotate_secret "$@" ;;
  mail-check) command_mail_check "$@" ;;
  doctor) command_doctor "$@" ;;
  up) command_up "$@" ;;
  status) command_status "$@" ;;
  finalize-bootstrap) command_finalize_bootstrap "$@" ;;
  diagnose) command_diagnose "$@" ;;
  uninstall) command_uninstall "$@" ;;
  *) refuse "$usage" ;;
esac
