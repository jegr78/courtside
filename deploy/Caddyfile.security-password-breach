{
	auto_https off
	admin off
}

https://:443 {
	tls /trust/cert.pem /trust/key.pem

	@range {
		host password-breach
		method GET
		path_regexp prefix ^/range/([A-F0-9]{5})$
		expression `{http.request.uri.query} == ""`
	}
	handle @range {
		rewrite * /range/{re.prefix.1}
		reverse_proxy https://api.pwnedpasswords.com {
			header_up Host api.pwnedpasswords.com
			header_up -Authorization
			header_up -Cookie
			header_up -Forwarded
			header_up -X-Forwarded-*
			header_up Add-Padding true
			transport http {
				tls_server_name api.pwnedpasswords.com
				dial_timeout 3s
				response_header_timeout 3s
				read_timeout 3s
			}
		}
	}
	handle {
		respond 404
	}
}
