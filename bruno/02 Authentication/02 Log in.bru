meta {
  name: Log in
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/session
  body: formUrlEncoded
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

body:form-urlencoded {
  username: {{username}}
  password: {{password}}
}

script:post-response {
  const headers = res.getHeader("set-cookie");
  const cookies = Array.isArray(headers) ? headers : [headers];
  const csrfCookie = cookies.filter((cookie) => /^XSRF-TOKEN=[^;]/.test(cookie ?? "")).pop();
  if (!csrfCookie) throw new Error("The response did not rotate the XSRF-TOKEN cookie");
  bru.setVar("csrfToken", csrfCookie.slice("XSRF-TOKEN=".length).split(";", 1)[0]);
}

tests {
  test("creates an authenticated session", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
