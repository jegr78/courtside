{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:security:manual-assessment-evidence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "runId",
    "tester",
    "recordedAt",
    "sourceCommit",
    "targetImageDigest",
    "targetFingerprint",
    "environment",
    "profile",
    "authorizationReference",
    "independentReview",
    "procedures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "tester": { "type": "string", "minLength": 1, "maxLength": 100 },
    "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "targetImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "targetFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "environment": { "enum": ["SECURITY", "UAT", "EXPLICIT_PRODUCTION"] },
    "profile": { "enum": ["safe", "active", "destructive"] },
    "authorizationReference": { "type": "string", "minLength": 1, "maxLength": 200 },
    "independentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed"],
      "properties": {
        "performed": { "type": "boolean" },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "allOf": [
        {
          "if": { "properties": { "performed": { "const": true } }, "required": ["performed"] },
          "then": { "required": ["reviewer"] }
        }
      ]
    },
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/procedure" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "enum": ["active", "destructive"] } }, "required": ["profile"] },
      "then": { "properties": { "environment": { "const": "SECURITY" } } }
    },
    {
      "if": { "properties": { "environment": { "const": "EXPLICIT_PRODUCTION" } }, "required": ["environment"] },
      "then": { "properties": { "profile": { "const": "safe" } } }
    }
  ],
  "$defs": {
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedureId",
        "controlIds",
        "prerequisites",
        "stepsPerformed",
        "expectedSecureOutcome",
        "observedResult",
        "redactedEvidenceReferences",
        "tester",
        "recordedAt",
        "targetImageDigest",
        "outcome"
      ],
      "properties": {
        "procedureId": { "type": "string", "pattern": "^MAN-[A-Z]+-[0-9]{3}$" },
        "controlIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(v5\\.0\\.0-[0-9]+\\.[0-9]+\\.[0-9]+|WSTG-v4\\.2-[A-Z]+-[0-9]{2})$"
          }
        },
        "prerequisites": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "stepsPerformed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "expectedSecureOutcome": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "observedResult": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "redactedEvidenceReferences": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "tester": { "type": "string", "minLength": 1, "maxLength": 100 },
        "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "targetImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "outcome": { "enum": ["pass", "fail", "not-applicable", "blocked"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "findingFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "enum": ["not-applicable", "blocked"] } }, "required": ["outcome"] },
          "then": { "required": ["rationale"] }
        },
        {
          "if": { "properties": { "outcome": { "const": "fail" } }, "required": ["outcome"] },
          "then": { "required": ["rationale", "findingFingerprint"] }
        }
      ]
    }
  }
}
