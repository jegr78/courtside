{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courtside.example.org/schemas/manual-baseline-control-outcomes.schema.json",
  "title": "Redacted per-control outcomes of a manual assessment run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "run",
    "controls"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "catalogVersion",
        "sourceCommit",
        "recordedAt"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "catalogVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "recordedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(v5\\.0\\.0-[0-9]+\\.[0-9]+\\.[0-9]+|WSTG-v4\\.2-[A-Z]+-[0-9]{2})$"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "not-applicable",
              "blocked"
            ]
          }
        }
      }
    }
  }
}
