{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:security:passive-deployment-evidence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "testId", "targetFingerprint", "imageDigest", "layers", "checks", "zap", "requestCount", "outcome"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "testId": { "const": "CSA-DEPLOY-001" },
    "targetFingerprint": { "$ref": "#/$defs/digest" },
    "imageDigest": { "type": "string", "pattern": "^(?:sha256:[a-f0-9]{64}|[^\\s@]+@sha256:[a-f0-9]{64})$" },
    "layers": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "items": { "enum": ["application", "proxy", "container", "host"] }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "outcome", "observation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "layer": { "enum": ["application", "proxy", "container", "host"] },
          "outcome": { "enum": ["passed", "failed", "not-applicable"] },
          "observation": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        }
      }
    },
    "zap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "version", "status", "alerts"],
      "properties": {
        "image": { "type": "string", "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$" },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "failed"] },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pluginId", "riskCode", "confidence", "count"],
            "properties": {
              "pluginId": { "type": "string", "pattern": "^[0-9]+$" },
              "riskCode": { "type": "integer", "minimum": 0, "maximum": 3 },
              "confidence": { "type": "integer", "minimum": 0, "maximum": 4 },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "requestCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "outcome": { "enum": ["passed", "failed", "incomplete"] }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
