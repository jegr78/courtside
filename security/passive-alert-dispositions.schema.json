{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courtside.example.org/schema/passive-alert-dispositions.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dispositions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disposition"
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "state",
        "rationale",
        "actor",
        "classifiedAt",
        "reference"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "false-positive",
            "duplicate"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "actor": {
          "$ref": "#/$defs/nonEmpty"
        },
        "classifiedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$"
        },
        "reference": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    }
  }
}
