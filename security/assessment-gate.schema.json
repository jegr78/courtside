{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:courtside:security:assessment-gate:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "generatedAt", "runId", "attempt", "profile", "status", "subject",
    "sourceCommit", "targetFingerprint", "catalogVersion", "tools", "selectedTests", "budgets",
    "startedAt", "finishedAt", "toolResults", "usage", "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,47}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "profile": { "enum": ["safe", "active", "destructive"] },
    "status": { "enum": ["passed", "failed", "incomplete"] },
    "subject": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "targetFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "catalogVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "selectedTests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CSA-[A-Z]+-[0-9]{3}$" }
    },
    "budgets": { "$ref": "urn:courtside:security:run-contract:v1#/$defs/profile" },
    "startedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "finishedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "toolResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "outcome"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 100 },
          "outcome": { "enum": ["passed", "failed", "incomplete"] }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "generatedDataMegabytes", "evidenceBytes"],
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "generatedDataMegabytes": { "type": "number", "minimum": 0 },
        "evidenceBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "allOf": [{
    "if": { "properties": { "status": { "enum": ["failed", "incomplete"] } }, "required": ["status"] },
    "then": { "required": ["reason"] }
  }]
}
